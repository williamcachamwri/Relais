<Window
    x:Class="UniversalClipboard.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Relais">

    <Grid
        x:Name="RootGrid"
        Background="#141416"
        KeyDown="OnRootGridKeyDown"
        SizeChanged="OnRootGridSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- =================================================================== -->
        <!-- TOP WINDOW BAR (Clean Brand Title + Draggable Region + Search Pill) -->
        <!-- =================================================================== -->
        <Border
            Grid.Row="0"
            Background="#151517"
            BorderBrush="#232326"
            BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left & Center Draggable Title Region -->
                <Grid
                    x:Name="TitleBarDragRegion"
                    Grid.Column="0"
                    Background="Transparent"
                    VerticalAlignment="Stretch"
                    Padding="16,0">
                    <StackPanel
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="10">
                        <FontIcon
                            Glyph="&#xE81E;"
                            FontSize="13.5"
                            Foreground="#8E8E96"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Text="Relais"
                            FontSize="12.5"
                            FontWeight="SemiBold"
                            Foreground="#D4D4DC"
                            VerticalAlignment="Center" />
                        <Border
                            x:Name="TitleBarHintDot"
                            Width="4"
                            Height="4"
                            CornerRadius="2"
                            Background="#3A3A42"
                            VerticalAlignment="Center"
                            Margin="2,0" />
                        <TextBlock
                            x:Name="TitleBarSyncHintText"
                            Text="iPhone ⇄ Windows"
                            FontSize="11.5"
                            Foreground="#6E6E76"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Right Search Pill (Perfectly vertically aligned, padded right for native caption buttons) -->
                <Border
                    x:Name="SearchPillBorder"
                    Grid.Column="1"
                    Width="300"
                    Height="30"
                    Margin="8,0,144,0"
                    Background="#202024"
                    BorderBrush="#2C2C32"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="11,0"
                    VerticalAlignment="Center">
                    <Grid ColumnSpacing="8" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Grid.Column="0"
                            Glyph="&#xE721;"
                            FontSize="12"
                            Foreground="#7C7C84"
                            VerticalAlignment="Center" />

                        <TextBox
                            x:Name="SearchBox"
                            Grid.Column="1"
                            PlaceholderText="Search clipboard..."
                            TextChanged="OnSearchTextChanged"
                            Background="Transparent"
                            BorderThickness="0"
                            MinHeight="0"
                            Height="26"
                            Padding="0,3,0,3"
                            FontSize="12.5"
                            Foreground="#ECECEF"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center">
                            <TextBox.Resources>
                                <x:Double x:Key="TextControlThemeMinHeight">24</x:Double>
                                <x:Double x:Key="TextControlThemeMinWidth">0</x:Double>
                                <Thickness x:Key="TextControlThemePadding">0,3,0,3</Thickness>
                                <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#7C7C84" />
                                <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#8E8E96" />
                                <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#6E6E76" />
                            </TextBox.Resources>
                        </TextBox>

                        <TextBlock
                            x:Name="SearchItemCountText"
                            Grid.Column="2"
                            Text="0 items"
                            FontSize="11.5"
                            Foreground="#6E6E76"
                            Typography.NumeralAlignment="Tabular"
                            VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- =================================================================== -->
        <!-- MAIN 4-COLUMN SPLIT WORKSPACE                                       -->
        <!-- =================================================================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColRail" Width="50" />
                <ColumnDefinition x:Name="ColSidebar" Width="180" />
                <ColumnDefinition x:Name="ColFeed" Width="330" />
                <ColumnDefinition x:Name="ColInspector" Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Global User Notification & Error InfoBar -->
            <InfoBar
                x:Name="GlobalNotificationInfoBar"
                Grid.ColumnSpan="4"
                IsOpen="False"
                IsClosable="True"
                Severity="Informational"
                Margin="60,10,20,0"
                VerticalAlignment="Top"
                Canvas.ZIndex="1000" />

            <!-- Floating AirDrop Incoming Transfer Request Modal / Banner -->
            <Border
                x:Name="AirDropIncomingPromptCard"
                Grid.ColumnSpan="4"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Margin="0,14,0,0"
                Background="#1C1C22"
                BorderBrush="#3B82F6"
                BorderThickness="1.5"
                CornerRadius="12"
                Padding="16,12"
                Visibility="Collapsed"
                Canvas.ZIndex="2000"
                MaxWidth="560">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- AirDrop Avatar / Icon -->
                    <Border
                        Grid.Column="0"
                        Width="40"
                        Height="40"
                        CornerRadius="20"
                        Background="#1E293B"
                        BorderBrush="#38BDF8"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE72D;" FontSize="17" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- Transfer Info -->
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                x:Name="AirDropIncomingSenderText"
                                Text="iPhone"
                                FontSize="13.5"
                                FontWeight="SemiBold"
                                Foreground="#FFFFFF" />
                            <Border
                                Background="#1E3A8A"
                                CornerRadius="4"
                                Padding="5,1"
                                VerticalAlignment="Center">
                                <TextBlock Text="AirDrop" FontSize="10" FontWeight="SemiBold" Foreground="#93C5FD" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            x:Name="AirDropIncomingFilesText"
                            Text="wants to share files"
                            FontSize="12"
                            Foreground="#94A3B8"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button
                            x:Name="AirDropDeclineBtn"
                            Click="OnAirDropDeclineClick"
                            Background="#282830"
                            BorderBrush="#383842"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="12,5">
                            <TextBlock Text="Decline" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" />
                        </Button>
                        <Button
                            x:Name="AirDropAcceptBtn"
                            Click="OnAirDropAcceptClick"
                            Background="#2563EB"
                            BorderBrush="#3B82F6"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="14,5">
                            <TextBlock Text="Accept" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- =============================================================== -->
            <!-- COLUMN 0: FAR-LEFT ICON RAIL                                    -->
            <!-- =============================================================== -->
            <Border
                Grid.Column="0"
                Background="#151517"
                BorderBrush="#232326"
                BorderThickness="0,0,1,0"
                Padding="0,10">
                <Grid>
                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Spacing="6">
                        <Button
                            x:Name="RailClipboardBtn"
                            Click="OnRailClipboardClick"
                            Width="34"
                            Height="34"
                            Padding="0"
                            CornerRadius="8"
                            Background="#2A2A2E"
                            BorderThickness="0"
                            ToolTipService.ToolTip="Clipboard History">
                            <FontIcon Glyph="&#xE81E;" FontSize="15" Foreground="#F2F2F5" />
                        </Button>

                        <Button
                            x:Name="RailAirDropBtn"
                            Click="OnRailAirDropClick"
                            Width="34"
                            Height="34"
                            Padding="0"
                            CornerRadius="8"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTipService.ToolTip="Apple AirDrop">
                            <FontIcon Glyph="&#xE72D;" FontSize="15" Foreground="#8A8A92" />
                        </Button>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Spacing="6">
                        <Button
                            x:Name="RailLogsBtn"
                            Click="OnRailLogsClick"
                            Width="34"
                            Height="34"
                            Padding="0"
                            CornerRadius="8"
                            Background="Transparent"
                            BorderThickness="0"
                            Visibility="Collapsed"
                            ToolTipService.ToolTip="Backend Logs">
                            <FontIcon Glyph="&#xE756;" FontSize="15" Foreground="#8A8A92" />
                        </Button>

                        <Button
                            x:Name="RailAboutBtn"
                            Click="OnRailAboutClick"
                            Width="34"
                            Height="34"
                            Padding="0"
                            CornerRadius="8"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTipService.ToolTip="About Relais">
                            <FontIcon Glyph="&#xE946;" FontSize="15" Foreground="#8A8A92" />
                        </Button>

                        <Button
                            x:Name="RailSettingsBtn"
                            Click="OnRailDeviceClick"
                            Width="34"
                            Height="34"
                            Padding="0"
                            CornerRadius="8"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTipService.ToolTip="Continuity Setup &amp; Settings">
                            <FontIcon Glyph="&#xE713;" FontSize="15" Foreground="#8A8A92" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- =============================================================== -->
            <!-- COLUMN 1: FILTER SIDEBAR (All, Favorites, TYPE, TAG, SOURCE)    -->
            <!-- =============================================================== -->
            <Border
                x:Name="FilterSidebarBorder"
                Grid.Column="1"
                Background="#17171A"
                BorderBrush="#232326"
                BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Hidden" Padding="10,10">
                    <StackPanel Spacing="2">
                        <!-- All & Favorites -->
                        <Button
                            x:Name="NavTypeAllBtn"
                            Tag="type:all"
                            Click="OnSidebarFilterClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Height="32"
                            Padding="10,0"
                            CornerRadius="8"
                            Background="#28282D"
                            BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xF0E2;" FontSize="13" Foreground="#F2F2F5" />
                                <TextBlock Text="All" FontSize="13" FontWeight="SemiBold" Foreground="#F2F2F5" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="NavTypeFavBtn"
                            Tag="type:favorites"
                            Click="OnSidebarFilterClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Height="32"
                            Padding="10,0"
                            CornerRadius="8"
                            Background="Transparent"
                            BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE734;" FontSize="13" Foreground="#9A9AA2" />
                                <TextBlock Text="Favorites" FontSize="13" Foreground="#9A9AA2" />
                            </StackPanel>
                        </Button>

                        <!-- TYPE Section -->
                        <TextBlock
                            Text="TYPE"
                            FontSize="10.5"
                            FontWeight="SemiBold"
                            Foreground="#5A5A62"
                            Margin="10,14,0,4" />

                        <Button
                            x:Name="NavTypeTextBtn"
                            Tag="type:text"
                            Click="OnSidebarFilterClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Height="32"
                            Padding="10,0"
                            CornerRadius="8"
                            Background="Transparent"
                            BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE8A5;" FontSize="13" Foreground="#9A9AA2" />
                                <TextBlock Text="Text" FontSize="13" Foreground="#9A9AA2" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="NavTypeRichBtn"
                            Tag="type:richtext"
                            Click="OnSidebarFilterClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Height="32"
                            Padding="10,0"
                            CornerRadius="8"
                            Background="Transparent"
                            BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE8A5;" FontSize="13" Foreground="#9A9AA2" />
                                <TextBlock Text="Rich Text" FontSize="13" Foreground="#9A9AA2" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="NavTypeImageBtn"
                            Tag="type:image"
                            Click="OnSidebarFilterClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Height="32"
                            Padding="10,0"
                            CornerRadius="8"
                            Background="Transparent"
                            BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xEB9F;" FontSize="13" Foreground="#9A9AA2" />
                                <TextBlock Text="Image" FontSize="13" Foreground="#9A9AA2" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="NavTypeFileBtn"
                            Tag="type:file"
                            Click="OnSidebarFilterClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Height="32"
                            Padding="10,0"
                            CornerRadius="8"
                            Background="Transparent"
                            BorderThickness="0"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE7C3;" FontSize="13" Foreground="#9A9AA2" />
                                <TextBlock Text="File" FontSize="13" Foreground="#9A9AA2" />
                            </StackPanel>
                        </Button>

                        <!-- TAG Section -->
                        <TextBlock
                            Text="TAG"
                            FontSize="10.5"
                            FontWeight="SemiBold"
                            Foreground="#5A5A62"
                            Margin="10,14,0,4" />

                        <Button
                            x:Name="NavTagLinkBtn"
                            Tag="tag:link"
                            Click="OnSidebarFilterClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Height="32"
                            Padding="10,0"
                            CornerRadius="8"
                            Background="Transparent"
                            BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE71B;" FontSize="13" Foreground="#9A9AA2" />
                                <TextBlock Text="Link" FontSize="13" Foreground="#9A9AA2" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="NavTagCodeBtn"
                            Tag="tag:code"
                            Click="OnSidebarFilterClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Height="32"
                            Padding="10,0"
                            CornerRadius="8"
                            Background="Transparent"
                            BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE943;" FontSize="13" Foreground="#9A9AA2" />
                                <TextBlock Text="Code" FontSize="13" Foreground="#9A9AA2" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="NavTagImageBtn"
                            Tag="tag:image"
                            Click="OnSidebarFilterClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Height="32"
                            Padding="10,0"
                            CornerRadius="8"
                            Background="Transparent"
                            BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xEB9F;" FontSize="13" Foreground="#9A9AA2" />
                                <TextBlock Text="Image" FontSize="13" Foreground="#9A9AA2" />
                            </StackPanel>
                        </Button>

                        <!-- SOURCE Section -->
                        <TextBlock
                            Text="SOURCE"
                            FontSize="10.5"
                            FontWeight="SemiBold"
                            Foreground="#5A5A62"
                            Margin="10,14,0,4" />

                        <Button
                            x:Name="NavSrcAllBtn"
                            Tag="src:all"
                            Click="OnSourceFilterClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Height="32"
                            Padding="10,0"
                            CornerRadius="8"
                            Background="#28282D"
                            BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE8E5;" FontSize="13" Foreground="#F2F2F5" />
                                <TextBlock Text="All sources" FontSize="13" FontWeight="SemiBold" Foreground="#F2F2F5" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="NavSrcPcBtn"
                            Tag="src:pc"
                            Click="OnSourceFilterClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Height="32"
                            Padding="10,0"
                            CornerRadius="8"
                            Background="Transparent"
                            BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE7F8;" FontSize="13" Foreground="#9A9AA2" />
                                <TextBlock
                                    x:Name="SidebarPcNameText"
                                    Text="This device"
                                    FontSize="13"
                                    Foreground="#9A9AA2"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="NavSrcIphoneBtn"
                            Tag="src:iphone"
                            Click="OnSourceFilterClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Height="32"
                            Padding="10,0"
                            CornerRadius="8"
                            Background="Transparent"
                            BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE8EA;" FontSize="13" Foreground="#9A9AA2" />
                                <TextBlock
                                    x:Name="SidebarIphoneNameText"
                                    Text="iPhone 16e"
                                    FontSize="13"
                                    Foreground="#9A9AA2"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>

                        <!-- TIME Section -->
                        <TextBlock
                            Text="TIME"
                            FontSize="10.5"
                            FontWeight="SemiBold"
                            Foreground="#5A5A62"
                            Margin="10,14,0,4" />

                        <Button
                            x:Name="NavTimeAllBtn"
                            Tag="time:all"
                            Click="OnTimeFilterClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Height="32"
                            Padding="10,0"
                            CornerRadius="8"
                            Background="#28282D"
                            BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE823;" FontSize="13" Foreground="#F2F2F5" />
                                <TextBlock Text="All time" FontSize="13" FontWeight="SemiBold" Foreground="#F2F2F5" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="NavTimeTodayBtn"
                            Tag="time:today"
                            Click="OnTimeFilterClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Height="32"
                            Padding="10,0"
                            CornerRadius="8"
                            Background="Transparent"
                            BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE823;" FontSize="13" Foreground="#9A9AA2" />
                                <TextBlock Text="Today" FontSize="13" Foreground="#9A9AA2" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- =============================================================== -->
            <!-- COLUMN 2: MIDDLE CLIPBOARD FEED LIST                            -->
            <!-- =============================================================== -->
            <Border
                Grid.Column="2"
                Background="#151517"
                BorderBrush="#232326"
                BorderThickness="0,0,1,0">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="HistoryListPanel" Spacing="0" Padding="0,6,0,6" />
                    </ScrollViewer>

                    <StackPanel
                        x:Name="EmptyFeedState"
                        Visibility="Collapsed"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="8"
                        Padding="24">
                        <TextBlock
                            Text="No clipboard items"
                            FontSize="13.5"
                            FontWeight="SemiBold"
                            Foreground="#8E8E96"
                            HorizontalAlignment="Center" />
                        <TextBlock
                            Text="Copy anything on your iPhone to sync automatically."
                            FontSize="12"
                            Foreground="#5A5A62"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- =============================================================== -->
            <!-- COLUMN 3: RIGHT INSPECTOR / PREVIEW PANE                        -->
            <!-- =============================================================== -->
            <Grid Grid.Column="3" Background="#131315">

                <!-- LAYER A: CLIPBOARD ITEM INSPECTOR (Matches Image #2 Right Pane) -->
                <Grid x:Name="InspectorPane">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="64" />
                    </Grid.RowDefinitions>

                    <!-- Top Inspector Metadata Bar -->
                    <Grid x:Name="InspectorTopBar" Grid.Row="0" Padding="24,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            x:Name="InspectorMetaLeftText"
                            Grid.Column="0"
                            Text="Text  ·  0 chars"
                            FontSize="12.5"
                            Foreground="#8A8A92"
                            TextTrimming="CharacterEllipsis"
                            Typography.NumeralAlignment="Tabular"
                            VerticalAlignment="Center" />

                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="14"
                            VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon
                                    x:Name="InspectorSourceIcon"
                                    Glyph="&#xE8EA;"
                                    FontSize="12"
                                    Foreground="#8A8A92" />
                                <TextBlock
                                    x:Name="InspectorSourceText"
                                    Text="iPhone 16e"
                                    FontSize="12.5"
                                    Foreground="#8A8A92" />
                            </StackPanel>

                            <Button
                                x:Name="InspectorPeerBtn"
                                Click="OnRailDeviceClick"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="6,4"
                                CornerRadius="6"
                                ToolTipService.ToolTip="Click to configure Continuity transport or wireless pairing">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon
                                        x:Name="InspectorPeerIcon"
                                        Glyph="&#xE701;"
                                        FontSize="12"
                                        Foreground="#8A8A92" />
                                    <TextBlock
                                        x:Name="InspectorPeerText"
                                        Text="Peer online"
                                        FontSize="12.5"
                                        Foreground="#8A8A92" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Center Preview Stage (Always Horizontally & Vertically Centered with Scroll Overflow Protection) -->
                    <ScrollViewer
                        Grid.Row="1"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
                        <Grid
                            x:Name="InspectorStageGrid"
                            Padding="24,16"
                            MinHeight="280"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center">

                            <!-- 1. IMAGE PREVIEW STAGE -->
                            <StackPanel
                                x:Name="InspectorImageStage"
                                Visibility="Collapsed"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                MaxWidth="640"
                                Spacing="14">
                                <Border
                                    Background="#16161D"
                                    BorderBrush="#282836"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <!-- Top Header Bar for Image Card -->
                                        <Border
                                            Grid.Row="0"
                                            Background="#1C1C26"
                                            BorderBrush="#262634"
                                            BorderThickness="0,0,0,1"
                                            CornerRadius="12,12,0,0"
                                            Height="38"
                                            Padding="14,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <Border
                                                        Background="#252534"
                                                        BorderBrush="#343448"
                                                        BorderThickness="1"
                                                        CornerRadius="5"
                                                        Padding="7,2"
                                                        VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                            <FontIcon Glyph="&#xEB9F;" FontSize="11" Foreground="#A0A0B0" />
