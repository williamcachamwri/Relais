<Window
    x:Class="UniversalClipboard.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Universal Clipboard">

    <Grid x:Name="RootGrid" Background="#0B0C10">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <!-- Top Translucent Navigation & Title Bar -->
        <Border
            Grid.Row="0"
            Background="#12141C"
            BorderBrush="#18FFFFFF"
            BorderThickness="0,0,0,1"
            Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: App Brand + Live iPhone Connection Pill (Draggable TitleBar Region) -->
                <StackPanel
                    x:Name="TitleBarDragRegion"
                    Grid.Column="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Spacing="12">
                    <Border
                        Width="32"
                        Height="32"
                        CornerRadius="8"
                        Background="#0A84FF"
                        BorderBrush="#40FFFFFF"
                        BorderThickness="1">
                        <FontIcon
                            Glyph="&#xE8C8;"
                            FontSize="15"
                            Foreground="#FFFFFF"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>

                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock
                            Text="Universal Clipboard"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#F5F5F7" />
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse
                                x:Name="HeaderStatusDot"
                                Width="7"
                                Height="7"
                                Fill="#FF9F0A"
                                VerticalAlignment="Center" />
                            <TextBlock
                                x:Name="HeaderDeviceText"
                                Text="Searching for iPhone..."
                                FontSize="11.5"
                                Foreground="#98989F"
                                Typography.NumeralAlignment="Tabular"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Center: Segmented View Switcher (Clipboard Manager vs Onboarding Setup) -->
                <Border
                    Grid.Column="1"
                    Background="#1B1E28"
                    BorderBrush="#16FFFFFF"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="3"
                    VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button
                            x:Name="NavClipboardBtn"
                            Click="OnNavClipboardClick"
                            Background="#2C3140"
                            BorderThickness="0"
                            CornerRadius="7"
                            Padding="14,6">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xF0E3;" FontSize="12" Foreground="#F5F5F7" />
                                <TextBlock
                                    Text="Clipboard"
                                    FontSize="12.5"
                                    FontWeight="SemiBold"
                                    Foreground="#F5F5F7" />
                                <Border
                                    x:Name="NavCountBadge"
                                    Background="#260A84FF"
                                    CornerRadius="5"
                                    Padding="5,1"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        x:Name="NavCountText"
                                        Text="0"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="#64D2FF"
                                        Typography.NumeralAlignment="Tabular" />
                                </Border>
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="NavOnboardingBtn"
                            Click="OnNavOnboardingClick"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="7"
                            Padding="14,6">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE895;" FontSize="12" Foreground="#98989F" />
                                <TextBlock
                                    x:Name="NavOnboardingText"
                                    Text="Onboarding"
                                    FontSize="12.5"
                                    FontWeight="Medium"
                                    Foreground="#98989F" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Right: Transport Mode Selector & Sync Now Button (padded right for system caption buttons) -->
                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,138,0"
                    Spacing="8">
                    <Border
                        Background="#1B1E28"
                        BorderBrush="#16FFFFFF"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="2">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button
                                x:Name="TransportAutoBtn"
                                Content="Auto"
                                Click="OnTransportAutoClick"
                                FontSize="11.5"
                                Padding="9,4"
                                CornerRadius="6"
                                BorderThickness="0"
                                Background="#0A84FF"
                                Foreground="#FFFFFF" />
                            <Button
                                x:Name="TransportWifiBtn"
                                Content="Wi-Fi"
                                Click="OnTransportWifiClick"
                                FontSize="11.5"
                                Padding="9,4"
                                CornerRadius="6"
                                BorderThickness="0"
                                Background="Transparent"
                                Foreground="#98989F" />
                            <Button
                                x:Name="TransportUsbBtn"
                                Content="USB"
                                Click="OnTransportUsbClick"
                                FontSize="11.5"
                                Padding="9,4"
                                CornerRadius="6"
                                BorderThickness="0"
                                Background="Transparent"
                                Foreground="#98989F" />
                        </StackPanel>
                    </Border>

                    <Button
                        x:Name="SyncNowBtn"
                        Click="OnSyncNowClick"
                        Background="#1E222D"
                        BorderBrush="#22FFFFFF"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="11,6"
                        ToolTipService.ToolTip="Pull current iPhone clipboard immediately">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="12" Foreground="#F5F5F7" />
                            <TextBlock Text="Sync" FontSize="12" FontWeight="Medium" Foreground="#F5F5F7" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- =================================================================== -->
        <!-- VIEW 1: CLIPBOARD MANAGER VIEW                                      -->
        <!-- =================================================================== -->
        <Grid x:Name="ClipboardManagerView" Grid.Row="1" Padding="28,20,28,12">
            <Grid MaxWidth="860" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Live Continuity Banner Card -->
                <Border
                    Grid.Row="0"
                    Background="#151821"
                    BorderBrush="#1AFFFFFF"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="18,14"
                    Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock
                                    x:Name="BannerHeadlineText"
                                    Text="Continuity Pasteboard Active"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="#F5F5F7" />
                                <Border
                                    x:Name="BannerTransportPill"
                                    Background="#1F30D158"
                                    BorderBrush="#4030D158"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,2">
                                    <TextBlock
                                        x:Name="BannerTransportText"
                                        Text="USB"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="#30D158" />
                                </Border>
                            </StackPanel>
                            <TextBlock
                                x:Name="BannerSubtext"
                                Text="Copy anything on your iPhone — Windows clipboard updates automatically for instant Ctrl + V."
                                FontSize="12.5"
                                Foreground="#98989F"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="16">
                            <StackPanel HorizontalAlignment="Right" Spacing="1">
                                <TextBlock
                                    Text="LAST LATENCY"
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    Foreground="#6E6E77" />
                                <TextBlock
                                    x:Name="MetricLatencyText"
                                    Text="— ms"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="#F5F5F7"
                                    Typography.NumeralAlignment="Tabular"
                                    HorizontalAlignment="Right" />
                            </StackPanel>

                            <Border Width="1" Height="26" Background="#1AFFFFFF" />

                            <StackPanel HorizontalAlignment="Right" Spacing="1">
                                <TextBlock
                                    Text="CHANGE COUNT"
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    Foreground="#6E6E77" />
                                <TextBlock
                                    x:Name="MetricChangeCountText"
                                    Text="#—"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="#64D2FF"
                                    Typography.NumeralAlignment="Tabular"
                                    HorizontalAlignment="Right" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Filter Pills + Instant Search Bar -->
                <Grid Grid.Row="1" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Category Filter Pills -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button
                            x:Name="FilterAllBtn"
                            Content="All"
                            Tag="all"
                            Click="OnFilterPillClick"
                            CornerRadius="8"
                            Padding="12,6"
                            FontSize="12.5"
                            FontWeight="SemiBold"
                            Background="#0A84FF"
                            Foreground="#FFFFFF"
                            BorderThickness="0" />
                        <Button
                            x:Name="FilterTextBtn"
                            Content="Text"
                            Tag="text"
                            Click="OnFilterPillClick"
                            CornerRadius="8"
                            Padding="12,6"
                            FontSize="12.5"
                            Background="#171A24"
                            Foreground="#98989F"
                            BorderBrush="#16FFFFFF"
                            BorderThickness="1" />
                        <Button
                            x:Name="FilterUrlBtn"
                            Content="Links"
                            Tag="url"
                            Click="OnFilterPillClick"
                            CornerRadius="8"
                            Padding="12,6"
                            FontSize="12.5"
                            Background="#171A24"
                            Foreground="#98989F"
                            BorderBrush="#16FFFFFF"
                            BorderThickness="1" />
                        <Button
                            x:Name="FilterImageBtn"
                            Content="Images"
                            Tag="image"
                            Click="OnFilterPillClick"
                            CornerRadius="8"
                            Padding="12,6"
                            FontSize="12.5"
                            Background="#171A24"
                            Foreground="#98989F"
                            BorderBrush="#16FFFFFF"
                            BorderThickness="1" />
                        <Button
                            x:Name="FilterPinnedBtn"
                            Content="Pinned ★"
                            Tag="pinned"
                            Click="OnFilterPillClick"
                            CornerRadius="8"
                            Padding="12,6"
                            FontSize="12.5"
                            Background="#171A24"
                            Foreground="#98989F"
                            BorderBrush="#16FFFFFF"
                            BorderThickness="1" />
                    </StackPanel>

                    <!-- Search Box -->
                    <TextBox
                        x:Name="SearchBox"
                        Grid.Column="1"
                        Margin="12,0"
                        PlaceholderText="Filter copied text, URLs, or UTI formats..."
                        TextChanged="OnSearchTextChanged"
                        Background="#151821"
                        BorderBrush="#1EFFFFFF"
                        CornerRadius="8"
                        FontSize="12.5"
                        VerticalAlignment="Center" />

                    <!-- Clear Unpinned Button -->
                    <Button
                        x:Name="ClearHistoryBtn"
                        Grid.Column="2"
                        Click="OnClearHistoryClick"
                        Background="#171A24"
                        BorderBrush="#16FFFFFF"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,6"
                        FontSize="12"
                        Foreground="#98989F">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74D;" FontSize="12" />
                            <TextBlock Text="Clear" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Scrollable Clipboard History Cards -->
                <Grid Grid.Row="2">
                    <ScrollViewer
                        x:Name="HistoryScrollViewer"
                        VerticalScrollBarVisibility="Auto"
                        Padding="0,0,4,12">
                        <StackPanel x:Name="HistoryListPanel" Spacing="10" />
                    </ScrollViewer>

                    <!-- Empty State Card -->
                    <Border
                        x:Name="EmptyStateCard"
                        Visibility="Collapsed"
                        Background="#13161F"
                        BorderBrush="#16FFFFFF"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="36"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="460">
                        <StackPanel Spacing="12" HorizontalAlignment="Center">
                            <Border
                                Width="48"
                                Height="48"
                                CornerRadius="14"
                                Background="#1A0A84FF"
                                BorderBrush="#330A84FF"
                                BorderThickness="1"
                                HorizontalAlignment="Center">
                                <FontIcon
                                    Glyph="&#xE8C8;"
                                    FontSize="22"
                                    Foreground="#0A84FF"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <TextBlock
                                Text="Ready for iPhone Copy"
                                FontSize="17"
                                FontWeight="SemiBold"
                                Foreground="#F5F5F7"
                                HorizontalAlignment="Center" />
                            <TextBlock
                                Text="Copy any text, link, or photo on your iPhone. It will appear here automatically and be ready to paste on Windows with Ctrl + V."
                                FontSize="13"
                                Foreground="#98989F"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                            <Button
                                Click="OnSyncNowClick"
                                Margin="0,6,0,0"
                                Background="#0A84FF"
                                Foreground="#FFFFFF"
                                BorderThickness="0"
                                CornerRadius="8"
                                Padding="16,8"
                                HorizontalAlignment="Center">
                                <TextBlock Text="Pull Current iPhone Clipboard" FontSize="12.5" FontWeight="SemiBold" />
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- =================================================================== -->
        <!-- VIEW 2: SIMPLE APPLE-STYLE ONBOARDING VIEW                          -->
        <!-- =================================================================== -->
        <ScrollViewer
            x:Name="OnboardingView"
            Grid.Row="1"
            Visibility="Collapsed"
            VerticalScrollBarVisibility="Auto"
            Padding="28,24">
            <StackPanel MaxWidth="640" HorizontalAlignment="Center" Spacing="20">

                <!-- Hero Header -->
                <StackPanel Spacing="8" Margin="0,4,0,4">
                    <Border
                        Background="#1F0A84FF"
                        BorderBrush="#400A84FF"
                        BorderThickness="1"
                        CornerRadius="999"
                        Padding="12,4"
                        HorizontalAlignment="Left">
                        <TextBlock
                            Text="APPLE COREDEVICE CONTINUITY"
                            FontSize="10.5"
                            FontWeight="Bold"
                            Foreground="#64D2FF" />
                    </Border>
                    <TextBlock
                        Text="Universal Clipboard for Windows"
                        FontSize="28"
                        FontWeight="SemiBold"
                        Foreground="#F5F5F7" />
                    <TextBlock
                        Text="Copy text, links, or images on your iPhone and press Ctrl + V directly on Windows. No Shortcuts, Back Tap, or manual Share Sheet required."
                        FontSize="14"
                        Foreground="#98989F"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!-- Step 1 Card: USB Trust & CoreDevice Discovery -->
                <Border
                    Background="#151821"
                    BorderBrush="#1AFFFFFF"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="20,18">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            x:Name="Step1IconBox"
                            Grid.Column="0"
                            Width="38"
                            Height="38"
                            CornerRadius="10"
                            Background="#1F30D158"
                            VerticalAlignment="Top">
                            <TextBlock
                                x:Name="Step1NumberText"
                                Text="1"
                                FontSize="15"
                                FontWeight="Bold"
                                Foreground="#30D158"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock
                                Text="Connect iPhone &amp; Trust This PC"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="#F5F5F7" />
                            <TextBlock
                                x:Name="Step1DetailText"
                                Text="Plug in your iPhone via USB once and tap 'Trust This Computer' to authorize Apple CoreDevice services."
                                FontSize="12.5"
                                Foreground="#98989F"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Border
                            x:Name="Step1StatusBadge"
                            Grid.Column="2"
                            Background="#1F30D158"
                            BorderBrush="#4030D158"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="10,4"
                            VerticalAlignment="Center">
                            <TextBlock
                                x:Name="Step1StatusText"
                                Text="✓ Trusted"
                                FontSize="11.5"
                                FontWeight="SemiBold"
                                Foreground="#30D158" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Step 2 Card: Wireless Continuity Pairing -->
                <Border
                    Background="#151821"
                    BorderBrush="#1AFFFFFF"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="20,18">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            x:Name="Step2IconBox"
                            Grid.Column="0"
                            Width="38"
                            Height="38"
                            CornerRadius="10"
                            Background="#1F0A84FF"
                            VerticalAlignment="Top">
                            <TextBlock
                                x:Name="Step2NumberText"
                                Text="2"
                                FontSize="15"
                                FontWeight="Bold"
                                Foreground="#64D2FF"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="8">
                            <TextBlock
                                Text="Enable Cable-Free Wi-Fi Sync"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="#F5F5F7" />
                            <TextBlock
                                x:Name="Step2DetailText"
                                Text="Creates a RemotePairing record over USB so your iPhone syncs clipboard changes wirelessly over local Wi-Fi (_remotepairing._tcp)."
                                FontSize="12.5"
                                Foreground="#98989F"
                                TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2,0,0">
                                <Button
                                    x:Name="PairWifiBtn"
                                    Click="OnPairWifiClick"
                                    Background="#222634"
                                    BorderBrush="#24FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,6">
                                    <TextBlock
                                        x:Name="PairWifiBtnText"
                                        Text="Pair Wireless Over USB"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="#F5F5F7" />
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <Border
                            x:Name="Step2StatusBadge"
                            Grid.Column="2"
                            Background="#1F30D158"
                            BorderBrush="#4030D158"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="10,4"
                            VerticalAlignment="Center">
                            <TextBlock
                                x:Name="Step2StatusText"
                                Text="✓ Paired"
                                FontSize="11.5"
                                FontWeight="SemiBold"
                                Foreground="#30D158" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Step 3 Card: Real-Time Pasteboard Stream -->
                <Border
                    Background="#151821"
                    BorderBrush="#1AFFFFFF"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="20,18">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            x:Name="Step3IconBox"
                            Grid.Column="0"
                            Width="38"
                            Height="38"
                            CornerRadius="10"
                            Background="#1F30D158"
                            VerticalAlignment="Top">
                            <TextBlock
                                x:Name="Step3NumberText"
                                Text="3"
                                FontSize="15"
                                FontWeight="Bold"
                                Foreground="#30D158"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock
                                Text="Copy on iPhone, Press Ctrl + V on Windows"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="#F5F5F7" />
                            <TextBlock
                                x:Name="Step3DetailText"
                                Text="Listening to com.apple.pasteboard.notify.changed. Text, Unicode, URLs, and Photos (HEIC/JPEG/PNG) are written directly to the Windows clipboard."
                                FontSize="12.5"
                                Foreground="#98989F"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Border
                            x:Name="Step3StatusBadge"
                            Grid.Column="2"
                            Background="#1F30D158"
                            BorderBrush="#4030D158"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="10,4"
                            VerticalAlignment="Center">
                            <TextBlock
                                x:Name="Step3StatusText"
                                Text="✓ Live"
                                FontSize="11.5"
                                FontWeight="SemiBold"
                                Foreground="#30D158" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Bottom Action CTA -->
                <Grid Margin="0,4,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        x:Name="OnboardingFeedbackText"
                        Grid.Column="0"
                        Text="All Continuity services are ready."
                        FontSize="12.5"
                        Foreground="#98989F"
                        VerticalAlignment="Center" />

                    <Button
                        x:Name="FinishOnboardingBtn"
                        Grid.Column="1"
                        Click="OnNavClipboardClick"
                        Background="#0A84FF"
                        Foreground="#FFFFFF"
                        BorderThickness="0"
                        CornerRadius="10"
                        Padding="20,10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Open Clipboard Manager" FontSize="13.5" FontWeight="SemiBold" />
                            <FontIcon Glyph="&#xE72A;" FontSize="12" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Subtle Status Footer -->
        <Border
            Grid.Row="2"
            Background="#0E1017"
            BorderBrush="#12FFFFFF"
            BorderThickness="0,1,0,0"
            Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="FooterStatusText"
                    Grid.Column="0"
                    Text="CoreDevice PasteboardService · POLICY_PROMISE_SECONDARY"
                    FontSize="11"
                    Foreground="#6E6E77"
                    VerticalAlignment="Center" />

                <TextBlock
                    x:Name="FooterUdidText"
                    Grid.Column="1"
                    Text=""
                    FontSize="11"
                    Foreground="#6E6E77"
                    Typography.NumeralAlignment="Tabular"
                    VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
