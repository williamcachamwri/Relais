                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <!-- Card Header Bar -->
                                        <Border
                                            Grid.Row="0"
                                            Background="#1C1C26"
                                            BorderBrush="#262634"
                                            BorderThickness="0,0,0,1"
                                            CornerRadius="12,12,0,0"
                                            Height="38"
                                            Padding="14,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Left: Type Badge & Header Title -->
                                                <StackPanel
                                                    x:Name="InspectorCardHeaderLeft"
                                                    Orientation="Horizontal"
                                                    Spacing="8"
                                                    VerticalAlignment="Center">
                                                    <Border
                                                        x:Name="InspectorTypeBadge"
                                                        Background="#22222E"
                                                        BorderBrush="#323242"
                                                        BorderThickness="1"
                                                        CornerRadius="5"
                                                        Padding="7,2"
                                                        VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                            <FontIcon
                                                                x:Name="InspectorTypeBadgeIcon"
                                                                Glyph="&#xE8A5;"
                                                                FontSize="11"
                                                                Foreground="#A0A0B0" />
                                                            <TextBlock
                                                                x:Name="InspectorTypeBadgeText"
                                                                Text="TEXT"
                                                                FontSize="10.5"
                                                                FontWeight="SemiBold"
                                                                Foreground="#D0D0DC"
                                                                Typography.NumeralAlignment="Tabular" />
                                                        </StackPanel>
                                                    </Border>

                                                    <TextBlock
                                                        x:Name="InspectorCardHeaderTitle"
                                                        Text="116 characters"
                                                        FontSize="12"
                                                        Foreground="#8A8A96"
                                                        VerticalAlignment="Center"
                                                        TextTrimming="CharacterEllipsis"
                                                        MaxWidth="300" />
                                                </StackPanel>

                                                <!-- Right: Actions (Open Link / Copy) -->
                                                <StackPanel
                                                    Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    Spacing="6"
                                                    VerticalAlignment="Center">
                                                    <Button
                                                        x:Name="InspectorOpenLinkBtn"
                                                        Click="OnInspectorOpenLinkClick"
                                                        Visibility="Collapsed"
                                                        Background="#182738"
                                                        BorderBrush="#243C56"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="9,3"
                                                        ToolTipService.ToolTip="Open URL in default web browser">
                                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <FontIcon Glyph="&#xE8A7;" FontSize="11" Foreground="#60A5FA" />
                                                            <TextBlock Text="Open Link" FontSize="11.5" FontWeight="Medium" Foreground="#93C5FD" />
                                                        </StackPanel>
                                                    </Button>

                                                    <Button
                                                        x:Name="InspectorHeaderCopyBtn"
                                                        Click="OnInspectorCopyClick"
                                                        Background="#22222C"
                                                        BorderBrush="#2E2E3A"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="8,3"
                                                        ToolTipService.ToolTip="Copy text to clipboard">
                                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                            <FontIcon Glyph="&#xE8C8;" FontSize="11" Foreground="#A0A0AA" />
                                                            <TextBlock Text="Copy" FontSize="11.5" Foreground="#D0D0DC" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Card Text Body -->
                                        <ScrollViewer
                                            Grid.Row="1"
                                            x:Name="InspectorTextScrollViewer"
                                            MaxHeight="330"
                                            Padding="20,16"
                                            VerticalScrollBarVisibility="Auto"
                                            HorizontalScrollBarVisibility="Disabled">
                                            <TextBlock
                                                x:Name="InspectorPreviewText"
                                                Text=""
                                                FontSize="13.5"
                                                Foreground="#EDEDF4"
                                                LineHeight="22"
                                                TextWrapping="Wrap"
                                                HorizontalAlignment="Stretch"
                                                TextAlignment="Left"
                                                IsTextSelectionEnabled="True" />
                                        </ScrollViewer>
                                    </Grid>
                                </Border>

                                <!-- Text Metadata Chips Row (Neat, Centered Pills) -->
                                <StackPanel
                                    x:Name="InspectorChipsPanel"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <Border
                                        x:Name="InspectorDirectionChip"
                                        Background="#181820"
                                        BorderBrush="#262632"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8,3">
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <FontIcon
                                                x:Name="InspectorDirectionIcon"
                                                Glyph="&#xE8EA;"
                                                FontSize="10.5"
                                                Foreground="#8A8A96" />
                                            <TextBlock
                                                x:Name="InspectorDirectionText"
                                                Text="Windows → iPhone"
                                                FontSize="11"
                                                Foreground="#A0A0AB" />
                                        </StackPanel>
                                    </Border>

                                    <Border
                                        x:Name="InspectorFormatChip"
                                        Background="#181820"
                                        BorderBrush="#262632"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8,3">
                                        <TextBlock
                                            x:Name="InspectorFormatText"
                                            Text="public.utf8-plain-text"
                                            FontSize="11"
                                            Foreground="#8A8A96"
                                            FontFamily="Cascadia Code, Consolas" />
                                    </Border>

                                    <Border
                                        x:Name="InspectorTransportChip"
                                        Background="#181820"
                                        BorderBrush="#262632"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8,3">
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <FontIcon
                                                x:Name="InspectorTransportIcon"
                                                Glyph="&#xE701;"
                                                FontSize="10.5"
                                                Foreground="#34D399" />
                                            <TextBlock
                                                x:Name="InspectorTransportText"
                                                Text="Wi-Fi"
                                                FontSize="11"
                                                Foreground="#A0A0AB" />
                                        </StackPanel>
                                    </Border>

                                    <Border
                                        x:Name="InspectorLatencyChip"
                                        Background="#181820"
                                        BorderBrush="#262632"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8,3">
                                        <TextBlock
                                            x:Name="InspectorLatencyText"
                                            Text="116 B · 132 ms"
                                            FontSize="11"
                                            Foreground="#8A8A96"
                                            Typography.NumeralAlignment="Tabular" />
                                    </Border>
                                </StackPanel>

                                <TextBlock
                                    x:Name="InspectorTextSubtitle"
                                    Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!-- Bottom Action Toolbar: Copy C · Send to iPhone S · Favorite F · Delete D -->
                    <Border
                        x:Name="InspectorActionBarBorder"
                        Grid.Row="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#17171B"
                        BorderBrush="#26262D"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="5,4"
                        Margin="0,0,0,16">
                        <StackPanel
                            x:Name="InspectorBarPanel"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="4">
                            <Button
                                x:Name="ActionCopyBtn"
                                Click="OnInspectorCopyClick"
                                Height="30"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="10,0"
                                CornerRadius="7"
                                VerticalAlignment="Center"
                                VerticalContentAlignment="Center"
                                ToolTipService.ToolTip="Copy to Windows clipboard (C)">
                                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                    <FontIcon
                                        Glyph="&#xE8C8;"
                                        FontSize="12.5"
                                        Foreground="#F2F2F5"
                                        VerticalAlignment="Center"
                                        Margin="0,1,0,0" />
                                    <TextBlock
                                        x:Name="ActionCopyLabel"
                                        Text="Copy"
                                        FontSize="12.5"
                                        FontWeight="SemiBold"
                                        Foreground="#F2F2F5"
                                        LineHeight="18"
                                        LineStackingStrategy="BlockLineHeight"
                                        VerticalAlignment="Center" />
                                    <Border
                                        x:Name="KeyHintC"
                                        Width="18"
                                        Height="18"
                                        CornerRadius="4"
                                        Background="#212127"
                                        BorderBrush="#2F2F37"
                                        BorderThickness="1"
                                        VerticalAlignment="Center"
                                        Margin="1,0,0,0">
                                        <TextBlock
                                            Text="C"
                                            FontSize="10.5"
                                            FontWeight="Medium"
                                            Foreground="#868690"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </Button>

                            <Border Width="1" Height="14" Background="#25252C" VerticalAlignment="Center" />

                            <Button
                                x:Name="ActionSendIphoneBtn"
                                Click="OnInspectorSendIphoneClick"
                                Height="30"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="10,0"
                                CornerRadius="7"
                                VerticalAlignment="Center"
                                VerticalContentAlignment="Center"
                                ToolTipService.ToolTip="Push this item to iPhone clipboard (S)">
                                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                    <FontIcon
                                        Glyph="&#xE8EA;"
                                        FontSize="12.5"
                                        Foreground="#A6A6B0"
                                        VerticalAlignment="Center"
                                        Margin="0,1,0,0" />
                                    <TextBlock
                                        x:Name="ActionSendIphoneLabel"
                                        Text="Send to iPhone"
                                        FontSize="12.5"
                                        FontWeight="Medium"
                                        Foreground="#A6A6B0"
                                        LineHeight="18"
                                        LineStackingStrategy="BlockLineHeight"
                                        VerticalAlignment="Center" />
                                    <Border
                                        x:Name="KeyHintS"
                                        Width="18"
                                        Height="18"
                                        CornerRadius="4"
                                        Background="#212127"
                                        BorderBrush="#2F2F37"
                                        BorderThickness="1"
                                        VerticalAlignment="Center"
                                        Margin="1,0,0,0">
                                        <TextBlock
                                            Text="S"
                                            FontSize="10.5"
                                            FontWeight="Medium"
                                            Foreground="#868690"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </Button>

                            <Border Width="1" Height="14" Background="#25252C" VerticalAlignment="Center" />

                            <Button
                                x:Name="ActionFavoriteBtn"
                                Click="OnInspectorFavoriteClick"
                                Height="30"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="10,0"
                                CornerRadius="7"
                                VerticalAlignment="Center"
                                VerticalContentAlignment="Center"
                                ToolTipService.ToolTip="Toggle Favorite (F)">
                                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                    <FontIcon
                                        x:Name="ActionFavoriteIcon"
                                        Glyph="&#xE734;"
                                        FontSize="12.5"
                                        Foreground="#A6A6B0"
                                        VerticalAlignment="Center"
                                        Margin="0,1,0,0" />
                                    <TextBlock
                                        x:Name="ActionFavoriteLabel"
                                        Text="Favorite"
                                        FontSize="12.5"
                                        FontWeight="Medium"
                                        Foreground="#A6A6B0"
                                        LineHeight="18"
                                        LineStackingStrategy="BlockLineHeight"
                                        VerticalAlignment="Center" />
                                    <Border
                                        x:Name="KeyHintF"
                                        Width="18"
                                        Height="18"
                                        CornerRadius="4"
                                        Background="#212127"
                                        BorderBrush="#2F2F37"
                                        BorderThickness="1"
                                        VerticalAlignment="Center"
                                        Margin="1,0,0,0">
                                        <TextBlock
                                            Text="F"
                                            FontSize="10.5"
                                            FontWeight="Medium"
                                            Foreground="#868690"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </Button>

                            <Border Width="1" Height="14" Background="#25252C" VerticalAlignment="Center" />

                            <Button
                                x:Name="ActionDeleteBtn"
                                Click="OnInspectorDeleteClick"
                                Height="30"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="10,0"
                                CornerRadius="7"
                                VerticalAlignment="Center"
                                VerticalContentAlignment="Center"
                                ToolTipService.ToolTip="Delete item (D)">
                                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                    <FontIcon
                                        Glyph="&#xE74D;"
                                        FontSize="12.5"
                                        Foreground="#A6A6B0"
                                        VerticalAlignment="Center"
                                        Margin="0,1,0,0" />
                                    <TextBlock
                                        x:Name="ActionDeleteLabel"
                                        Text="Delete"
                                        FontSize="12.5"
                                        FontWeight="Medium"
                                        Foreground="#A6A6B0"
                                        LineHeight="18"
                                        LineStackingStrategy="BlockLineHeight"
                                        VerticalAlignment="Center" />
                                    <Border
                                        x:Name="KeyHintD"
                                        Width="18"
                                        Height="18"
                                        CornerRadius="4"
                                        Background="#212127"
                                        BorderBrush="#2F2F37"
                                        BorderThickness="1"
                                        VerticalAlignment="Center"
                                        Margin="1,0,0,0">
                                        <TextBlock
                                            Text="D"
                                            FontSize="10.5"
                                            FontWeight="Medium"
                                            Foreground="#868690"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- LAYER B: CONTINUITY & ONBOARDING PANE (Same neutral #18181B palette) -->
                <ScrollViewer
                    x:Name="OnboardingPane"
                    Visibility="Collapsed"
                    VerticalScrollBarVisibility="Auto"
                    Padding="36,28">
                    <StackPanel MaxWidth="520" HorizontalAlignment="Center" Spacing="18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock
                                    Text="Continuity Setup"
                                    FontSize="19"
                                    FontWeight="SemiBold"
                                    Foreground="#F2F2F5" />
                                <TextBlock
                                    Text="Automatic iPhone to Windows clipboard synchronization via CoreDevice."
                                    FontSize="12.5"
                                    Foreground="#8A8A92" />
                            </StackPanel>

                            <Button
                                Grid.Column="1"
                                Click="OnRailClipboardClick"
                                Background="#212125"
                                BorderBrush="#2C2C30"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="12,5"
                                VerticalAlignment="Top">
                                <TextBlock Text="Done" FontSize="12" FontWeight="SemiBold" Foreground="#F2F2F5" />
                            </Button>
                        </Grid>

                        <!-- Step 1 -->
                        <Border
                            Background="#18181B"
                            BorderBrush="#242428"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16,14">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Text="01"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#6E6E76"
                                    Typography.NumeralAlignment="Tabular"
                                    VerticalAlignment="Top"
                                    Margin="0,2,0,0" />
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock
                                        Text="USB Trust &amp; Device Pairing"
                                        FontSize="13.5"
                                        FontWeight="SemiBold"
                                        Foreground="#F2F2F5" />
                                    <TextBlock
                                        x:Name="Step1DetailText"
                                        Text="Connect iPhone over USB once and tap Trust This Computer."
                                        FontSize="12"
                                        Foreground="#8A8A92"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock
                                    x:Name="Step1StatusText"
                                    Grid.Column="2"
                                    Text="Trusted"
                                    FontSize="12"
                                    Foreground="#28C840"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Step 2 -->
                        <Border
                            Background="#18181B"
                            BorderBrush="#242428"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16,14">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Text="02"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#6E6E76"
                                    Typography.NumeralAlignment="Tabular"
                                    VerticalAlignment="Top"
                                    Margin="0,2,0,0" />
                                <StackPanel Grid.Column="1" Spacing="8">
                                    <TextBlock
                                        Text="Wireless Continuity (_remotepairing._tcp)"
                                        FontSize="13.5"
                                        FontWeight="SemiBold"
                                        Foreground="#F2F2F5" />
                                    <TextBlock
                                        Text="Create a RemotePairing record over USB so clipboard sync works over local Wi-Fi without cables."
                                        FontSize="12"
                                        Foreground="#8A8A92"
                                        TextWrapping="Wrap" />
                                    <Button
                                        x:Name="PairWifiBtn"
                                        Click="OnPairWifiClick"
                                        Background="#232328"
                                        BorderBrush="#2E2E34"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Padding="12,5">
                                        <TextBlock
                                            x:Name="PairWifiBtnText"
                                            Text="Pair Wireless Over USB"
                                            FontSize="12"
                                            Foreground="#F2F2F5" />
                                    </Button>
                                </StackPanel>
                                <TextBlock
                                    x:Name="Step2StatusText"
                                    Grid.Column="2"
                                    Text="Paired"
                                    FontSize="12"
                                    Foreground="#28C840"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Step 3: Transport Mode & Clear -->
                        <Border
                            Background="#18181B"
                            BorderBrush="#242428"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16,14">
                            <Grid ColumnSpacing="14">
