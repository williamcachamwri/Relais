                                        <Border
                                            Width="64"
                                            Height="64"
                                            CornerRadius="14"
                                            Background="#232330"
                                            BorderBrush="#323242"
                                            BorderThickness="1"
                                            HorizontalAlignment="Center">
                                            <TextBlock
                                                x:Name="InspectorFileExtText"
                                                Text="ZIP"
                                                FontSize="15"
                                                FontWeight="Bold"
                                                Foreground="#E8E8EE"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                        </Border>

                                        <TextBlock
                                            x:Name="InspectorFileTitleText"
