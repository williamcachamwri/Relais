                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Image Badges Chips Row -->
                                <StackPanel
                                    x:Name="InspectorImageChipsPanel"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    HorizontalAlignment="Center">
                                    <Border
                                        Background="#181820"
                                        BorderBrush="#262632"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8,3">
                                        <TextBlock
                                            x:Name="InspectorImageDirText"
                                            Text="iPhone → Windows"
                                            FontSize="11"
                                            Foreground="#A0A0AB" />
                                    </Border>
                                    <Border
                                        Background="#181820"
                                        BorderBrush="#262632"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8,3">
                                        <TextBlock
                                            x:Name="InspectorImageUtiText"
                                            Text="public.png"
                                            FontSize="11"
                                            Foreground="#8A8A96"
                                            FontFamily="Cascadia Code, Consolas" />
                                    </Border>
                                    <Border
                                        Background="#181820"
                                        BorderBrush="#262632"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8,3">
                                        <TextBlock
                                            x:Name="InspectorImageTransportText"
                                            Text="Wi-Fi · 130 ms"
                                            FontSize="11"
                                            Foreground="#8A8A96" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <!-- 2. FILE PREVIEW STAGE -->
                            <StackPanel
                                x:Name="InspectorFileStage"
