                                    TextAlignment="Center"
                                    TextWrapping="Wrap"
                                    HorizontalAlignment="Center" />
                            </StackPanel>

                            <!-- 3. TEXT / LINK / CODE PREVIEW STAGE -->
                            <StackPanel
                                x:Name="InspectorTextStage"
