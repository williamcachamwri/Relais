<Window
    x:Class="UniversalClipboard.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Relais">

    <Grid
        x:Name="RootGrid"
        Background="#0A0A0A"
        KeyDown="OnRootGridKeyDown"
        SizeChanged="OnRootGridSizeChanged">

        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- =================================================================== -->
        <!-- TOP WINDOW BAR (Clean Brand Title + Draggable Region + Search Pill) -->
        <!-- =================================================================== -->
        <Border
            Grid.Row="0"
            Background="#0A0A0A" BorderThickness="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left & Center Draggable Title Region -->
                <Grid
                    x:Name="TitleBarDragRegion"
                    Grid.Column="0"
                    Background="Transparent"
                    VerticalAlignment="Stretch"
                    Padding="16,0">
                    <StackPanel
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="10">
                        <Border
                            Width="18"
                            Height="18"
                            CornerRadius="4.5"
                            VerticalAlignment="Center">
                            <Image
                                Source="ms-appx:///Assets/logo_48.png"
                                Stretch="UniformToFill" />
                        </Border>
                        <TextBlock
                            Text="Relais"
                            FontSize="12.5"
                            FontWeight="SemiBold"
                            Foreground="#D5D5D5"
                            VerticalAlignment="Center" />
                        <Border
                            x:Name="TitleBarHintDot"
                            Width="4"
                            Height="4"
                            CornerRadius="2.0"
                            Background="#2A2A2A"
                            VerticalAlignment="Center"
                            Margin="2,0" />
                        <TextBlock
                            x:Name="TitleBarSyncHintText"
                            Text="iPhone ⇄ Windows"
                            FontSize="11.5"
                            Foreground="#6F6F6F"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Right Search Pill (Perfectly vertically aligned, padded right for native caption buttons) -->
                <Border
                    x:Name="SearchPillBorder"
                    Grid.Column="1"
                    Width="320"
                    Height="32"
                    Margin="8,0,144,0"
                    Background="#171717"
                    BorderBrush="#202020"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="11,0"
                    VerticalAlignment="Center">
                    <Grid ColumnSpacing="8" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Grid.Column="0"
                            Glyph="&#xE721;"
                            FontSize="12"
                            Foreground="#7D7D7D"
                            VerticalAlignment="Center" />

                        <TextBox
                            x:Name="SearchBox"
                            Grid.Column="1"
                            PlaceholderText="Search clipboard..."
                            TextChanged="OnSearchTextChanged"
                            Background="Transparent"
                            BorderThickness="0"
                            MinHeight="0"
                            Height="26"
                            Padding="0,3,0,3"
                            FontSize="12.5"
                            Foreground="#ECECEC"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center">
                            <TextBox.Resources>
                                <x:Double x:Key="TextControlThemeMinHeight">24</x:Double>
                                <x:Double x:Key="TextControlThemeMinWidth">0</x:Double>
                                <Thickness x:Key="TextControlThemePadding">0,3,0,3</Thickness>
                                <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#7D7D7D" />
                                <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#8F8F8F" />
                                <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#6F6F6F" />
                            </TextBox.Resources>
                        </TextBox>

                        <TextBlock
                            x:Name="SearchItemCountText"
                            Grid.Column="2"
                            Text="0 items"
                            FontSize="11.5"
                            Foreground="#6F6F6F"
                            Typography.NumeralAlignment="Tabular"
                            VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- =================================================================== -->
        <!-- MAIN 4-COLUMN SPLIT WORKSPACE                                       -->
        <!-- =================================================================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColRail" Width="50" />
                <ColumnDefinition x:Name="ColSidebar" Width="172" />
                <ColumnDefinition x:Name="ColFeed" Width="348" />
                <ColumnDefinition x:Name="ColInspector" Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Global User Notification & Error InfoBar -->
            <InfoBar
                x:Name="GlobalNotificationInfoBar"
                Grid.ColumnSpan="4"
                IsOpen="False"
                IsClosable="True"
                Severity="Informational"
                Margin="60,10,20,0"
                VerticalAlignment="Top"
                Canvas.ZIndex="1000" />

            <!-- =============================================================== -->
            <!-- COLUMN 0: FAR-LEFT ICON RAIL                                    -->
            <!-- =============================================================== -->
            <Border
                Grid.Column="0"
                Background="#0A0A0A" BorderThickness="0"
                Padding="0,10">
                <Grid>
                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Spacing="6">
                        <Button
                            x:Name="RailClipboardBtn"
                            Click="OnRailClipboardClick"
                            Width="34"
                            Height="34"
                            Padding="0"
                            CornerRadius="6"
                            Background="#1E1E1E"
                            BorderThickness="0"
                            ToolTipService.ToolTip="Clipboard History">
                            <Border Width="22" Height="22" CornerRadius="5.5" VerticalAlignment="Center">
                                <Image Source="ms-appx:///Assets/logo_64.png" Stretch="UniformToFill" />
                            </Border>
                        </Button>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Spacing="6">
                        <Button
                            x:Name="RailLogsBtn"
                            Click="OnRailLogsClick"
                            Width="34"
                            Height="34"
                            Padding="0"
                            CornerRadius="6"
                            Background="Transparent"
                            BorderThickness="0"
                            Visibility="Collapsed"
                            ToolTipService.ToolTip="Backend Logs">
                            <FontIcon Glyph="&#xE756;" FontSize="15" Foreground="#8B8B8B" />
                        </Button>

                        <Button
                            x:Name="RailAboutBtn"
                            Click="OnRailAboutClick"
                            Width="34"
                            Height="34"
                            Padding="0"
                            CornerRadius="6"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTipService.ToolTip="About Relais">
                            <FontIcon Glyph="&#xE946;" FontSize="15" Foreground="#8B8B8B" />
                        </Button>

                        <Button
                            x:Name="RailSettingsBtn"
                            Click="OnRailDeviceClick"
                            Width="34"
                            Height="34"
                            Padding="0"
                            CornerRadius="6"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTipService.ToolTip="Continuity Setup &amp; Settings">
                            <FontIcon Glyph="&#xE713;" FontSize="15" Foreground="#8B8B8B" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- =============================================================== -->
            <!-- COLUMN 1: FILTER SIDEBAR (All, Favorites, TYPE, TAG, SOURCE)    -->
            <!-- =============================================================== -->
            <Border
                x:Name="FilterSidebarBorder"
                Grid.Column="1"
                Background="#0A0A0A" BorderThickness="0">
                <ScrollViewer VerticalScrollBarVisibility="Hidden" Padding="10,10">
                    <StackPanel Spacing="2">
                        <!-- All & Favorites -->
                        <Button
                            x:Name="NavTypeAllBtn"
                            Tag="type:all"
                            Click="OnSidebarFilterClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Height="32"
                            Padding="10,0"
                            CornerRadius="6"
                            Background="#1E1E1E"
                            BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xF0E2;" FontSize="13" Foreground="#F2F2F2" />
                                <TextBlock Text="All" FontSize="13" FontWeight="SemiBold" Foreground="#F2F2F2" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="NavTypeFavBtn"
                            Tag="type:favorites"
                            Click="OnSidebarFilterClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Height="32"
                            Padding="10,0"
                            CornerRadius="6"
                            Background="Transparent"
                            BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE734;" FontSize="13" Foreground="#9B9B9B" />
                                <TextBlock Text="Favorites" FontSize="13" Foreground="#9B9B9B" />
                            </StackPanel>
                        </Button>

                        <!-- TYPE Section -->
                        <TextBlock
                            Text="TYPE"
                            FontSize="10.5"
                            FontWeight="SemiBold"
                            Foreground="#5B5B5B"
                            Margin="10,14,0,4" />

                        <Button
                            x:Name="NavTypeTextBtn"
                            Tag="type:text"
                            Click="OnSidebarFilterClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Height="32"
                            Padding="10,0"
                            CornerRadius="6"
                            Background="Transparent"
                            BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE8A5;" FontSize="13" Foreground="#9B9B9B" />
                                <TextBlock Text="Text" FontSize="13" Foreground="#9B9B9B" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="NavTypeRichBtn"
                            Tag="type:richtext"
                            Click="OnSidebarFilterClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Height="32"
                            Padding="10,0"
                            CornerRadius="6"
                            Background="Transparent"
                            BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE8A5;" FontSize="13" Foreground="#9B9B9B" />
                                <TextBlock Text="Rich Text" FontSize="13" Foreground="#9B9B9B" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="NavTypeImageBtn"
                            Tag="type:image"
                            Click="OnSidebarFilterClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Height="32"
                            Padding="10,0"
                            CornerRadius="6"
                            Background="Transparent"
                            BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xEB9F;" FontSize="13" Foreground="#9B9B9B" />
                                <TextBlock Text="Image" FontSize="13" Foreground="#9B9B9B" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="NavTypeFileBtn"
                            Tag="type:file"
                            Click="OnSidebarFilterClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Height="32"
                            Padding="10,0"
                            CornerRadius="6"
                            Background="Transparent"
                            BorderThickness="0"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE7C3;" FontSize="13" Foreground="#9B9B9B" />
                                <TextBlock Text="File" FontSize="13" Foreground="#9B9B9B" />
                            </StackPanel>
                        </Button>

                        <!-- TAG Section -->
                        <TextBlock
                            Text="TAG"
                            FontSize="10.5"
                            FontWeight="SemiBold"
                            Foreground="#5B5B5B"
                            Margin="10,14,0,4" />

                        <Button
                            x:Name="NavTagLinkBtn"
                            Tag="tag:link"
                            Click="OnSidebarFilterClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Height="32"
                            Padding="10,0"
                            CornerRadius="6"
                            Background="Transparent"
                            BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE71B;" FontSize="13" Foreground="#9B9B9B" />
                                <TextBlock Text="Link" FontSize="13" Foreground="#9B9B9B" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="NavTagCodeBtn"
                            Tag="tag:code"
                            Click="OnSidebarFilterClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Height="32"
                            Padding="10,0"
                            CornerRadius="6"
                            Background="Transparent"
                            BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE943;" FontSize="13" Foreground="#9B9B9B" />
                                <TextBlock Text="Code" FontSize="13" Foreground="#9B9B9B" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="NavTagImageBtn"
                            Tag="tag:image"
                            Click="OnSidebarFilterClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Height="32"
                            Padding="10,0"
                            CornerRadius="6"
                            Background="Transparent"
                            BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xEB9F;" FontSize="13" Foreground="#9B9B9B" />
                                <TextBlock Text="Image" FontSize="13" Foreground="#9B9B9B" />
                            </StackPanel>
                        </Button>

                        <!-- SOURCE Section -->
                        <TextBlock
                            Text="SOURCE"
                            FontSize="10.5"
                            FontWeight="SemiBold"
                            Foreground="#5B5B5B"
                            Margin="10,14,0,4" />

                        <Button
                            x:Name="NavSrcAllBtn"
                            Tag="src:all"
                            Click="OnSourceFilterClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Height="32"
                            Padding="10,0"
                            CornerRadius="6"
                            Background="#1E1E1E"
                            BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE8E5;" FontSize="13" Foreground="#F2F2F2" />
                                <TextBlock Text="All sources" FontSize="13" FontWeight="SemiBold" Foreground="#F2F2F2" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="NavSrcPcBtn"
                            Tag="src:pc"
                            Click="OnSourceFilterClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Height="32"
                            Padding="10,0"
                            CornerRadius="6"
                            Background="Transparent"
                            BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE7F8;" FontSize="13" Foreground="#9B9B9B" />
                                <TextBlock
                                    x:Name="SidebarPcNameText"
                                    Text="This device"
                                    FontSize="13"
                                    Foreground="#9B9B9B"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="NavSrcIphoneBtn"
                            Tag="src:iphone"
                            Click="OnSourceFilterClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Height="32"
                            Padding="10,0"
                            CornerRadius="6"
                            Background="Transparent"
                            BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE8EA;" FontSize="13" Foreground="#9B9B9B" />
                                <TextBlock
                                    x:Name="SidebarIphoneNameText"
                                    Text="iPhone 16e"
                                    FontSize="13"
                                    Foreground="#9B9B9B"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>

                        <!-- TIME Section -->
                        <TextBlock
                            Text="TIME"
                            FontSize="10.5"
                            FontWeight="SemiBold"
                            Foreground="#5B5B5B"
                            Margin="10,14,0,4" />

                        <Button
                            x:Name="NavTimeAllBtn"
                            Tag="time:all"
                            Click="OnTimeFilterClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Height="32"
                            Padding="10,0"
                            CornerRadius="6"
                            Background="#1E1E1E"
                            BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE823;" FontSize="13" Foreground="#F2F2F2" />
                                <TextBlock Text="All time" FontSize="13" FontWeight="SemiBold" Foreground="#F2F2F2" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="NavTimeTodayBtn"
                            Tag="time:today"
                            Click="OnTimeFilterClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Height="32"
                            Padding="10,0"
                            CornerRadius="6"
                            Background="Transparent"
                            BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE823;" FontSize="13" Foreground="#9B9B9B" />
                                <TextBlock Text="Today" FontSize="13" Foreground="#9B9B9B" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- =============================================================== -->
            <!-- COLUMN 2: MIDDLE CLIPBOARD FEED LIST                            -->
            <!-- =============================================================== -->
            <Border
                Grid.Column="2"
                Background="#0F0F0F"
                BorderBrush="#191919"
                BorderThickness="0,0,1,0">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="HistoryListPanel" Spacing="0" Padding="0,6,0,6" />
                    </ScrollViewer>

                    <StackPanel
                        x:Name="EmptyFeedState"
                        Visibility="Collapsed"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="8"
                        Padding="24">
                        <TextBlock
                            Text="No clipboard items"
                            FontSize="13.5"
                            FontWeight="SemiBold"
                            Foreground="#8F8F8F"
                            HorizontalAlignment="Center" />
                        <TextBlock
                            Text="Copy anything on your iPhone to sync automatically."
                            FontSize="12"
                            Foreground="#5B5B5B"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- =============================================================== -->
            <!-- COLUMN 3: RIGHT INSPECTOR / PREVIEW PANE                        -->
            <!-- =============================================================== -->
            <Grid Grid.Column="3" Background="#0A0A0A">

                <!-- LAYER A: CLIPBOARD ITEM INSPECTOR (Matches Image #2 Right Pane) -->
                <Grid x:Name="InspectorPane">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="64" />
                    </Grid.RowDefinitions>

                    <!-- Top Inspector Metadata Bar -->
                    <Grid x:Name="InspectorTopBar" Grid.Row="0" Padding="24,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            x:Name="InspectorMetaLeftText"
                            Grid.Column="0"
                            Text="Text  ·  0 chars"
                            FontSize="12.5"
                            Foreground="#8B8B8B"
                            TextTrimming="CharacterEllipsis"
                            Typography.NumeralAlignment="Tabular"
                            VerticalAlignment="Center" />

                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="14"
                            VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon
                                    x:Name="InspectorSourceIcon"
                                    Glyph="&#xE8EA;"
                                    FontSize="12"
                                    Foreground="#8B8B8B" />
                                <TextBlock
                                    x:Name="InspectorSourceText"
                                    Text="iPhone 16e"
                                    FontSize="12.5"
                                    Foreground="#8B8B8B" />
                            </StackPanel>

                            <Button
                                x:Name="InspectorPeerBtn"
                                Click="OnRailDeviceClick"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="6,4"
                                CornerRadius="6.0"
                                ToolTipService.ToolTip="Click to configure Continuity transport or wireless pairing">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon
                                        x:Name="InspectorPeerIcon"
                                        Glyph="&#xE701;"
                                        FontSize="12"
                                        Foreground="#8B8B8B" />
                                    <TextBlock
                                        x:Name="InspectorPeerText"
                                        Text="Peer online"
                                        FontSize="12.5"
                                        Foreground="#8B8B8B" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Center Preview Stage (Always Horizontally & Vertically Centered with Scroll Overflow Protection) -->
                    <ScrollViewer
                        Grid.Row="1"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
                        <Grid
                            x:Name="InspectorStageGrid"
                            Padding=" 32,24"
                            MinHeight=" 280"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top">

                            <!-- 1. IMAGE PREVIEW STAGE (Frameless, Direct Canvas, Mouse-Wheel Zoomable) -->
                            <Grid
                                x:Name="InspectorImageStage"
                                Visibility="Collapsed"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                MinHeight="300">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Zoomable Image Viewport -->
                                <ScrollViewer
                                    x:Name="InspectorImageScrollViewer"
                                    Grid.Row="0"
                                    HorizontalScrollBarVisibility="Hidden"
                                    VerticalScrollBarVisibility="Hidden"
                                    ZoomMode="Enabled"
                                    MinZoomFactor="0.2"
                                    MaxZoomFactor="5.0"
                                    Background="Transparent"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    DoubleTapped="OnImageDoubleTapped"
                                    PointerWheelChanged="OnImagePointerWheelChanged">
                                    <Image
                                        x:Name="InspectorPreviewImage"
                                        Stretch="Uniform"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        MaxHeight="460"
                                        MaxWidth="720" />
                                </ScrollViewer>

                                <!-- Minimalist Single-Line Caption (Clean, Anti-AI Slop) -->
                                <StackPanel
                                    Grid.Row="1"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    HorizontalAlignment="Center"
                                    Margin="0,12,0,4">
                                    <TextBlock
                                        x:Name="InspectorImageMetaText"
                                        Text="PNG"
                                        FontSize="12"
                                        Foreground="#7B7B7B"
                                        Typography.NumeralAlignment="Tabular"
                                        VerticalAlignment="Center" />
                                    <TextBlock Text="·" FontSize="12" Foreground="#454545" VerticalAlignment="Center" />
                                    <TextBlock
                                        x:Name="InspectorImageTransportText"
                                        Text="Wi-Fi"
                                        FontSize="12"
                                        Foreground="#7B7B7B"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <!-- 2. FILE PREVIEW STAGE -->
                            <StackPanel
                                x:Name="InspectorFileStage"
                                Visibility="Collapsed"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                MaxWidth="520"
                                Spacing="14">
                                <Border
                                    Background="#121212"
                                    BorderBrush="#1A1A1A"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="36,26"
                                    HorizontalAlignment="Center">
                                    <StackPanel Spacing="16" HorizontalAlignment="Center">
                                        <Border
                                            Width="64"
                                            Height="64"
                                            CornerRadius="10"
                                            Background="#181818"
                                            BorderBrush="#222222"
                                            BorderThickness="1"
                                            HorizontalAlignment="Center">
                                            <TextBlock
                                                x:Name="InspectorFileExtText"
                                                Text="ZIP"
                                                FontSize="15"
                                                FontWeight="Bold"
                                                Foreground="#E9E9E9"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                        </Border>

                                        <TextBlock
                                            x:Name="InspectorFileTitleText"
                                            Text="document.zip"
                                            FontSize="14.5"
                                            FontWeight="SemiBold"
                                            Foreground="#F2F2F2"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap"
                                            MaxWidth="420"
                                            HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <TextBlock
                                    x:Name="InspectorFileSubtitle"
                                    Text=""
                                    FontSize="11.5"
