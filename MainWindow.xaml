                                <!-- Hardware Diagnostics Chips -->
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Hardware &amp; Network Diagnostics" FontSize="11.5" FontWeight="SemiBold" Foreground="#6E6E78" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Grid.Column="0"
                                            Background="#151518"
                                            BorderBrush="#222226"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="8,6">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="BLUETOOTH" FontSize="9.5" FontWeight="Bold" Foreground="#60A5FA" />
                                                <TextBlock x:Name="AirDropBleStatusChip" Text="Advertising Wake" FontSize="11" Foreground="#D4D4DE" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>

                                        <Border
                                            Grid.Column="1"
                                            Background="#151518"
                                            BorderBrush="#222226"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="8,6">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="WI-FI ADAPTER" FontSize="9.5" FontWeight="Bold" Foreground="#34D399" />
                                                <TextBlock x:Name="AirDropWifiStatusChip" Text="Intel AX211" FontSize="11" Foreground="#D4D4DE" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>

                                        <Border
                                            Grid.Column="2"
                                            Background="#151518"
                                            BorderBrush="#222226"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="8,6">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="PROTOCOL" FontSize="9.5" FontWeight="Bold" Foreground="#A78BFA" />
                                                <TextBlock x:Name="AirDropProtoStatusChip" Text="mDNS &amp; HTTPS" FontSize="11" Foreground="#D4D4DE" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <TextBlock
                                        x:Name="AirDropAwdlNote"
                                        Text="Zero-configuration native AirDrop: iPhones on the same Wi-Fi network discover this PC instantly via BLE beacon and mDNS HTTPS responder. Windows SmartScreen Mark-of-the-Web is applied to all incoming files."
                                        FontSize="11"
                                        Foreground="#6E6E78"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Active Transfer Progress (Visible when receiving) -->
                        <Border
                            x:Name="AirDropActiveTransferCard"
                            Visibility="Collapsed"
                            Background="#18181B"
                            BorderBrush="#3B82F6"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16,14">
                            <StackPanel Spacing="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            x:Name="AirDropActiveTransferTitle"
                                            Text="Receiving from iPhone..."
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="#F2F2F5" />
                                        <TextBlock
                                            x:Name="AirDropActiveTransferSub"
                                            Text="Photo.heic (12.4 MB)"
                                            FontSize="12"
                                            Foreground="#8A8A92" />
                                    </StackPanel>
                                    <TextBlock
                                        x:Name="AirDropActiveTransferPercent"
                                        Grid.Column="1"
                                        Text="0%"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Foreground="#38BDF8"
                                        VerticalAlignment="Center" />
                                </Grid>
                                <ProgressBar
                                    x:Name="AirDropActiveProgressBar"
                                    Value="0"
                                    Maximum="100"
                                    Height="6"
                                    Foreground="#3B82F6"
                                    Background="#232328"
                                    CornerRadius="3" />
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Recent AirDrop Transfers -->
                        <Border
                            Background="#18181B"
                            BorderBrush="#242428"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16,14">
                            <StackPanel Spacing="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Text="Recent Transfers"
                                        FontSize="13.5"
                                        FontWeight="SemiBold"
                                        Foreground="#F2F2F5" />
                                    <TextBlock
                                        x:Name="AirDropTransferCountText"
                                        Grid.Column="1"
                                        Text="0 received"
                                        FontSize="11.5"
                                        Foreground="#6E6E78" />
                                </Grid>

                                <!-- Transfer list container -->
                                <StackPanel x:Name="AirDropRecentTransfersPanel" Spacing="8">
                                    <TextBlock
                                        x:Name="AirDropNoTransfersText"
                                        Text="No AirDrop transfers received yet. Send a photo or file from iPhone via AirDrop to see it here."
                                        FontSize="12"
                                        Foreground="#6E6E78"
                                        Padding="4,8" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
