<Window
    x:Class="UniversalClipboard.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Universal Clipboard">

    <Grid
        x:Name="RootGrid"
        Background="#141416"
        KeyDown="OnRootGridKeyDown"
        SizeChanged="OnRootGridSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- =================================================================== -->
        <!-- TOP WINDOW BAR (Clean Brand Title + Draggable Region + Search Pill) -->
        <!-- =================================================================== -->
        <Border
            Grid.Row="0"
            Background="#151517"
            BorderBrush="#232326"
            BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left & Center Draggable Title Region -->
                <Grid
                    x:Name="TitleBarDragRegion"
                    Grid.Column="0"
                    Background="Transparent"
                    VerticalAlignment="Stretch"
                    Padding="16,0">
                    <StackPanel
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="10">
                        <FontIcon
                            Glyph="&#xE81E;"
                            FontSize="13.5"
                            Foreground="#8E8E96"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Text="Universal Clipboard"
                            FontSize="12.5"
                            FontWeight="SemiBold"
                            Foreground="#D4D4DC"
                            VerticalAlignment="Center" />
                        <Border
                            x:Name="TitleBarHintDot"
                            Width="4"
                            Height="4"
                            CornerRadius="2"
                            Background="#3A3A42"
                            VerticalAlignment="Center"
                            Margin="2,0" />
                        <TextBlock
                            x:Name="TitleBarSyncHintText"
                            Text="iPhone ⇄ Windows"
                            FontSize="11.5"
                            Foreground="#6E6E76"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Right Search Pill (Perfectly vertically aligned, padded right for native caption buttons) -->
                <Border
                    x:Name="SearchPillBorder"
                    Grid.Column="1"
                    Width="300"
                    Height="30"
                    Margin="8,0,144,0"
                    Background="#202024"
                    BorderBrush="#2C2C32"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="11,0"
                    VerticalAlignment="Center">
                    <Grid ColumnSpacing="8" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Grid.Column="0"
                            Glyph="&#xE721;"
                            FontSize="12"
                            Foreground="#7C7C84"
                            VerticalAlignment="Center" />

                        <TextBox
                            x:Name="SearchBox"
                            Grid.Column="1"
                            PlaceholderText="Search clipboard..."
                            TextChanged="OnSearchTextChanged"
                            Background="Transparent"
                            BorderThickness="0"
                            MinHeight="0"
                            Height="26"
                            Padding="0,3,0,3"
                            FontSize="12.5"
                            Foreground="#ECECEF"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center">
                            <TextBox.Resources>
                                <x:Double x:Key="TextControlThemeMinHeight">24</x:Double>
                                <x:Double x:Key="TextControlThemeMinWidth">0</x:Double>
                                <Thickness x:Key="TextControlThemePadding">0,3,0,3</Thickness>
                                <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#7C7C84" />
                                <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#8E8E96" />
                                <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#6E6E76" />
                            </TextBox.Resources>
                        </TextBox>

                        <TextBlock
                            x:Name="SearchItemCountText"
                            Grid.Column="2"
                            Text="0 items"
                            FontSize="11.5"
                            Foreground="#6E6E76"
                            Typography.NumeralAlignment="Tabular"
                            VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- =================================================================== -->
        <!-- MAIN 4-COLUMN SPLIT WORKSPACE                                       -->
        <!-- =================================================================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColRail" Width="50" />
                <ColumnDefinition x:Name="ColSidebar" Width="180" />
                <ColumnDefinition x:Name="ColFeed" Width="310" />
                <ColumnDefinition x:Name="ColInspector" Width="*" />
            </Grid.ColumnDefinitions>

            <!-- =============================================================== -->
            <!-- COLUMN 0: FAR-LEFT ICON RAIL                                    -->
            <!-- =============================================================== -->
            <Border
                Grid.Column="0"
                Background="#151517"
                BorderBrush="#232326"
                BorderThickness="0,0,1,0"
                Padding="0,10">
                <Grid>
                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Spacing="6">
                        <Button
                            x:Name="RailClipboardBtn"
                            Click="OnRailClipboardClick"
                            Width="34"
                            Height="34"
                            Padding="0"
                            CornerRadius="8"
                            Background="#2A2A2E"
                            BorderThickness="0"
                            ToolTipService.ToolTip="Clipboard History">
                            <FontIcon Glyph="&#xE81E;" FontSize="15" Foreground="#F2F2F5" />
                        </Button>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Spacing="6">
                        <Button
                            x:Name="RailAboutBtn"
                            Click="OnRailAboutClick"
                            Width="34"
                            Height="34"
                            Padding="0"
                            CornerRadius="8"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTipService.ToolTip="About Universal Clipboard">
                            <FontIcon Glyph="&#xE946;" FontSize="15" Foreground="#8A8A92" />
                        </Button>

                        <Button
                            x:Name="RailSettingsBtn"
                            Click="OnRailDeviceClick"
                            Width="34"
                            Height="34"
                            Padding="0"
                            CornerRadius="8"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTipService.ToolTip="Continuity Setup &amp; Settings">
                            <FontIcon Glyph="&#xE713;" FontSize="15" Foreground="#8A8A92" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- =============================================================== -->
            <!-- COLUMN 1: FILTER SIDEBAR (All, Favorites, TYPE, TAG, SOURCE)    -->
            <!-- =============================================================== -->
            <Border
                x:Name="FilterSidebarBorder"
                Grid.Column="1"
                Background="#17171A"
                BorderBrush="#232326"
                BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Hidden" Padding="10,10">
                    <StackPanel Spacing="2">
                        <!-- All & Favorites -->
                        <Button
                            x:Name="NavTypeAllBtn"
                            Tag="type:all"
                            Click="OnSidebarFilterClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Height="32"
                            Padding="10,0"
                            CornerRadius="8"
                            Background="#28282D"
                            BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xF0E2;" FontSize="13" Foreground="#F2F2F5" />
                                <TextBlock Text="All" FontSize="13" FontWeight="SemiBold" Foreground="#F2F2F5" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="NavTypeFavBtn"
                            Tag="type:favorites"
                            Click="OnSidebarFilterClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Height="32"
                            Padding="10,0"
                            CornerRadius="8"
                            Background="Transparent"
                            BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE734;" FontSize="13" Foreground="#9A9AA2" />
                                <TextBlock Text="Favorites" FontSize="13" Foreground="#9A9AA2" />
                            </StackPanel>
                        </Button>

                        <!-- TYPE Section -->
                        <TextBlock
                            Text="TYPE"
                            FontSize="10.5"
                            FontWeight="SemiBold"
                            Foreground="#5A5A62"
                            Margin="10,14,0,4" />

                        <Button
                            x:Name="NavTypeTextBtn"
                            Tag="type:text"
                            Click="OnSidebarFilterClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Height="32"
                            Padding="10,0"
                            CornerRadius="8"
                            Background="Transparent"
                            BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE8A5;" FontSize="13" Foreground="#9A9AA2" />
                                <TextBlock Text="Text" FontSize="13" Foreground="#9A9AA2" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="NavTypeRichBtn"
                            Tag="type:richtext"
                            Click="OnSidebarFilterClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Height="32"
                            Padding="10,0"
                            CornerRadius="8"
                            Background="Transparent"
                            BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE8A5;" FontSize="13" Foreground="#9A9AA2" />
                                <TextBlock Text="Rich Text" FontSize="13" Foreground="#9A9AA2" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="NavTypeImageBtn"
                            Tag="type:image"
                            Click="OnSidebarFilterClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Height="32"
                            Padding="10,0"
                            CornerRadius="8"
                            Background="Transparent"
                            BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xEB9F;" FontSize="13" Foreground="#9A9AA2" />
                                <TextBlock Text="Image" FontSize="13" Foreground="#9A9AA2" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="NavTypeFileBtn"
                            Tag="type:file"
                            Click="OnSidebarFilterClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Height="32"
                            Padding="10,0"
                            CornerRadius="8"
                            Background="Transparent"
                            BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE7C3;" FontSize="13" Foreground="#9A9AA2" />
                                <TextBlock Text="File" FontSize="13" Foreground="#9A9AA2" />
                            </StackPanel>
                        </Button>

                        <!-- TAG Section -->
                        <TextBlock
                            Text="TAG"
                            FontSize="10.5"
                            FontWeight="SemiBold"
                            Foreground="#5A5A62"
                            Margin="10,14,0,4" />

                        <Button
                            x:Name="NavTagLinkBtn"
                            Tag="tag:link"
                            Click="OnSidebarFilterClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Height="32"
                            Padding="10,0"
                            CornerRadius="8"
                            Background="Transparent"
                            BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE71B;" FontSize="13" Foreground="#9A9AA2" />
                                <TextBlock Text="Link" FontSize="13" Foreground="#9A9AA2" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="NavTagCodeBtn"
                            Tag="tag:code"
                            Click="OnSidebarFilterClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Height="32"
                            Padding="10,0"
                            CornerRadius="8"
                            Background="Transparent"
                            BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE943;" FontSize="13" Foreground="#9A9AA2" />
                                <TextBlock Text="Code" FontSize="13" Foreground="#9A9AA2" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="NavTagImageBtn"
                            Tag="tag:image"
                            Click="OnSidebarFilterClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Height="32"
                            Padding="10,0"
                            CornerRadius="8"
                            Background="Transparent"
                            BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xEB9F;" FontSize="13" Foreground="#9A9AA2" />
                                <TextBlock Text="Image" FontSize="13" Foreground="#9A9AA2" />
                            </StackPanel>
                        </Button>

                        <!-- SOURCE Section -->
                        <TextBlock
                            Text="SOURCE"
                            FontSize="10.5"
                            FontWeight="SemiBold"
                            Foreground="#5A5A62"
                            Margin="10,14,0,4" />

                        <Button
                            x:Name="NavSrcAllBtn"
                            Tag="src:all"
                            Click="OnSourceFilterClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Height="32"
                            Padding="10,0"
                            CornerRadius="8"
                            Background="#28282D"
                            BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE8E5;" FontSize="13" Foreground="#F2F2F5" />
                                <TextBlock Text="All sources" FontSize="13" FontWeight="SemiBold" Foreground="#F2F2F5" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="NavSrcPcBtn"
                            Tag="src:pc"
                            Click="OnSourceFilterClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Height="32"
                            Padding="10,0"
                            CornerRadius="8"
                            Background="Transparent"
                            BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE7F8;" FontSize="13" Foreground="#9A9AA2" />
                                <TextBlock
                                    x:Name="SidebarPcNameText"
                                    Text="This device"
                                    FontSize="13"
                                    Foreground="#9A9AA2"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="NavSrcIphoneBtn"
                            Tag="src:iphone"
                            Click="OnSourceFilterClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Height="32"
                            Padding="10,0"
                            CornerRadius="8"
                            Background="Transparent"
                            BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE8EA;" FontSize="13" Foreground="#9A9AA2" />
                                <TextBlock
                                    x:Name="SidebarIphoneNameText"
                                    Text="iPhone 16e"
                                    FontSize="13"
                                    Foreground="#9A9AA2"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>

                        <!-- TIME Section -->
                        <TextBlock
                            Text="TIME"
                            FontSize="10.5"
                            FontWeight="SemiBold"
                            Foreground="#5A5A62"
                            Margin="10,14,0,4" />

                        <Button
                            x:Name="NavTimeAllBtn"
                            Tag="time:all"
                            Click="OnTimeFilterClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Height="32"
                            Padding="10,0"
                            CornerRadius="8"
                            Background="#28282D"
                            BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE823;" FontSize="13" Foreground="#F2F2F5" />
                                <TextBlock Text="All time" FontSize="13" FontWeight="SemiBold" Foreground="#F2F2F5" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="NavTimeTodayBtn"
                            Tag="time:today"
                            Click="OnTimeFilterClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Height="32"
                            Padding="10,0"
                            CornerRadius="8"
                            Background="Transparent"
                            BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE823;" FontSize="13" Foreground="#9A9AA2" />
                                <TextBlock Text="Today" FontSize="13" Foreground="#9A9AA2" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- =============================================================== -->
            <!-- COLUMN 2: MIDDLE CLIPBOARD FEED LIST                            -->
            <!-- =============================================================== -->
            <Border
                Grid.Column="2"
                Background="#151517"
                BorderBrush="#232326"
                BorderThickness="0,0,1,0">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="HistoryListPanel" Spacing="0" Padding="0,6,0,6" />
                    </ScrollViewer>

                    <StackPanel
                        x:Name="EmptyFeedState"
                        Visibility="Collapsed"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="8"
                        Padding="24">
                        <TextBlock
                            Text="No clipboard items"
                            FontSize="13.5"
                            FontWeight="SemiBold"
                            Foreground="#8E8E96"
                            HorizontalAlignment="Center" />
                        <TextBlock
                            Text="Copy anything on your iPhone to sync automatically."
                            FontSize="12"
                            Foreground="#5A5A62"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- =============================================================== -->
            <!-- COLUMN 3: RIGHT INSPECTOR / PREVIEW PANE                        -->
            <!-- =============================================================== -->
            <Grid Grid.Column="3" Background="#131315">

                <!-- LAYER A: CLIPBOARD ITEM INSPECTOR (Matches Image #2 Right Pane) -->
                <Grid x:Name="InspectorPane">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="64" />
                    </Grid.RowDefinitions>

                    <!-- Top Inspector Metadata Bar -->
                    <Grid x:Name="InspectorTopBar" Grid.Row="0" Padding="24,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            x:Name="InspectorMetaLeftText"
                            Grid.Column="0"
                            Text="Text  ·  0 chars"
                            FontSize="12.5"
                            Foreground="#8A8A92"
                            TextTrimming="CharacterEllipsis"
                            Typography.NumeralAlignment="Tabular"
                            VerticalAlignment="Center" />

                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="14"
                            VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon
                                    x:Name="InspectorSourceIcon"
                                    Glyph="&#xE8EA;"
                                    FontSize="12"
                                    Foreground="#8A8A92" />
                                <TextBlock
                                    x:Name="InspectorSourceText"
                                    Text="iPhone 16e"
                                    FontSize="12.5"
                                    Foreground="#8A8A92" />
                            </StackPanel>

                            <Button
                                x:Name="InspectorPeerBtn"
                                Click="OnRailDeviceClick"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="6,4"
                                CornerRadius="6"
                                ToolTipService.ToolTip="Click to configure Continuity transport or wireless pairing">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon
                                        x:Name="InspectorPeerIcon"
                                        Glyph="&#xE701;"
                                        FontSize="12"
                                        Foreground="#8A8A92" />
                                    <TextBlock
                                        x:Name="InspectorPeerText"
                                        Text="Peer online"
                                        FontSize="12.5"
                                        Foreground="#8A8A92" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Center Preview Stage (Always Horizontally & Vertically Centered) -->
                    <Grid
                        x:Name="InspectorStageGrid"
                        Grid.Row="1"
                        Padding="28,16"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                        <!-- Image Preview Stage -->
                        <StackPanel
                            x:Name="InspectorImageStage"
                            Visibility="Collapsed"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="16">
                            <Border
                                Background="#0D0D0F"
                                BorderBrush="#2C2C30"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="6"
                                HorizontalAlignment="Center">
                                <Image
                                    x:Name="InspectorPreviewImage"
                                    MaxHeight="340"
                                    MaxWidth="520"
                                    Stretch="Uniform" />
                            </Border>

                            <TextBlock
                                x:Name="InspectorImageTitleText"
                                Text="Clipboard.png"
                                FontSize="15.5"
                                FontWeight="SemiBold"
                                Foreground="#F2F2F5"
                                TextTrimming="CharacterEllipsis"
                                HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- File Preview Stage (Monochrome Carbon-Gray Badge) -->
                        <StackPanel
                            x:Name="InspectorFileStage"
                            Visibility="Collapsed"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            MaxWidth="480"
                            Spacing="16">
                            <Border
                                Background="#18181B"
                                BorderBrush="#252529"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="36,28"
                                HorizontalAlignment="Center">
                                <StackPanel Spacing="16" HorizontalAlignment="Center">
                                    <Border
                                        Width="68"
                                        Height="68"
                                        CornerRadius="14"
                                        Background="#25252C"
                                        BorderBrush="#363640"
                                        BorderThickness="1"
                                        HorizontalAlignment="Center">
                                        <TextBlock
                                            x:Name="InspectorFileExtText"
                                            Text="ZIP"
                                            FontSize="16"
                                            FontWeight="Bold"
                                            Foreground="#E8E8EE"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>

                                    <TextBlock
                                        x:Name="InspectorFileTitleText"
                                        Text="document.zip"
                                        FontSize="15.5"
                                        FontWeight="SemiBold"
                                        Foreground="#F2F2F5"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap"
                                        MaxWidth="380"
                                        HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <TextBlock
                                x:Name="InspectorFileSubtitle"
                                Text=""
                                FontSize="12"
                                Foreground="#6E6E76"
                                Typography.NumeralAlignment="Tabular"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Text / Link / Code Preview Stage -->
                        <StackPanel
                            x:Name="InspectorTextStage"
                            Visibility="Visible"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Width="460"
                            Spacing="14">
                            <Border
                                x:Name="InspectorTextCardBorder"
                                Background="#18181B"
                                BorderBrush="#252529"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="22,18"
                                MaxHeight="360">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBlock
                                        x:Name="InspectorPreviewText"
                                        Text=""
                                        FontSize="14"
                                        Foreground="#F2F2F5"
                                        LineHeight="22"
                                        TextWrapping="Wrap"
                                        IsTextSelectionEnabled="True" />
                                </ScrollViewer>
                            </Border>

                            <TextBlock
                                x:Name="InspectorTextSubtitle"
                                Text=""
                                FontSize="12"
                                Foreground="#6E6E76"
                                Typography.NumeralAlignment="Tabular"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- Bottom Action Toolbar: Copy C · Send to iPhone S · Favorite F · Delete D -->
                    <Border
                        Grid.Row="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#18181C"
                        BorderBrush="#26262C"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="4">
                    <StackPanel
                        x:Name="InspectorBarPanel"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="16">
                        <Button
                            x:Name="ActionCopyBtn"
                            Click="OnInspectorCopyClick"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="10,6"
                            CornerRadius="6"
                            ToolTipService.ToolTip="Copy to Windows clipboard (C)">
                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8C8;" FontSize="13" Foreground="#F2F2F5" />
                                <TextBlock
                                    x:Name="ActionCopyLabel"
                                    Text="Copy"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="#F2F2F5" />
                                <TextBlock
                                    x:Name="KeyHintC"
                                    Text="C"
                                    FontSize="12"
                                    Foreground="#5A5A62"
                                    Margin="2,0,0,0" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="ActionSendIphoneBtn"
                            Click="OnInspectorSendIphoneClick"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="10,6"
                            CornerRadius="6"
                            ToolTipService.ToolTip="Push this item to iPhone clipboard (S)">
                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8EA;" FontSize="13" Foreground="#9A9AA2" />
                                <TextBlock
                                    x:Name="ActionSendIphoneLabel"
                                    Text="Send to iPhone"
                                    FontSize="13"
                                    Foreground="#9A9AA2" />
                                <TextBlock
                                    x:Name="KeyHintS"
                                    Text="S"
                                    FontSize="12"
                                    Foreground="#5A5A62"
                                    Margin="2,0,0,0" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="ActionFavoriteBtn"
                            Click="OnInspectorFavoriteClick"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="10,6"
                            CornerRadius="6"
                            ToolTipService.ToolTip="Toggle Favorite (F)">
                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <FontIcon
                                    x:Name="ActionFavoriteIcon"
                                    Glyph="&#xE734;"
                                    FontSize="13"
                                    Foreground="#9A9AA2" />
                                <TextBlock
                                    x:Name="ActionFavoriteLabel"
                                    Text="Favorite"
                                    FontSize="13"
                                    Foreground="#9A9AA2" />
                                <TextBlock
                                    x:Name="KeyHintF"
                                    Text="F"
                                    FontSize="12"
                                    Foreground="#5A5A62"
                                    Margin="2,0,0,0" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="ActionDeleteBtn"
                            Click="OnInspectorDeleteClick"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="10,6"
                            CornerRadius="6"
                            ToolTipService.ToolTip="Delete item (D)">
                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="#9A9AA2" />
                                <TextBlock
                                    x:Name="ActionDeleteLabel"
                                    Text="Delete"
                                    FontSize="13"
                                    Foreground="#9A9AA2" />
                                <TextBlock
                                    x:Name="KeyHintD"
                                    Text="D"
                                    FontSize="12"
                                    Foreground="#5A5A62"
                                    Margin="2,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    </Border>
                </Grid>

                <!-- LAYER B: CONTINUITY & ONBOARDING PANE (Same neutral #18181B palette) -->
                <ScrollViewer
                    x:Name="OnboardingPane"
                    Visibility="Collapsed"
                    VerticalScrollBarVisibility="Auto"
                    Padding="36,28">
                    <StackPanel MaxWidth="520" HorizontalAlignment="Center" Spacing="18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock
                                    Text="Continuity Setup"
                                    FontSize="19"
                                    FontWeight="SemiBold"
                                    Foreground="#F2F2F5" />
                                <TextBlock
                                    Text="Automatic iPhone to Windows clipboard synchronization via CoreDevice."
                                    FontSize="12.5"
                                    Foreground="#8A8A92" />
                            </StackPanel>

                            <Button
                                Grid.Column="1"
                                Click="OnRailClipboardClick"
                                Background="#212125"
                                BorderBrush="#2C2C30"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="12,5"
                                VerticalAlignment="Top">
                                <TextBlock Text="Done" FontSize="12" FontWeight="SemiBold" Foreground="#F2F2F5" />
                            </Button>
                        </Grid>

                        <!-- Step 1 -->
                        <Border
                            Background="#18181B"
                            BorderBrush="#242428"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16,14">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Text="01"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#6E6E76"
                                    Typography.NumeralAlignment="Tabular"
                                    VerticalAlignment="Top"
                                    Margin="0,2,0,0" />
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock
                                        Text="USB Trust &amp; Device Pairing"
                                        FontSize="13.5"
                                        FontWeight="SemiBold"
                                        Foreground="#F2F2F5" />
                                    <TextBlock
                                        x:Name="Step1DetailText"
                                        Text="Connect iPhone over USB once and tap Trust This Computer."
                                        FontSize="12"
                                        Foreground="#8A8A92"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock
                                    x:Name="Step1StatusText"
                                    Grid.Column="2"
                                    Text="Trusted"
                                    FontSize="12"
                                    Foreground="#28C840"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Step 2 -->
                        <Border
                            Background="#18181B"
                            BorderBrush="#242428"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16,14">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Text="02"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#6E6E76"
                                    Typography.NumeralAlignment="Tabular"
                                    VerticalAlignment="Top"
                                    Margin="0,2,0,0" />
                                <StackPanel Grid.Column="1" Spacing="8">
                                    <TextBlock
                                        Text="Wireless Continuity (_remotepairing._tcp)"
                                        FontSize="13.5"
                                        FontWeight="SemiBold"
                                        Foreground="#F2F2F5" />
                                    <TextBlock
                                        Text="Create a RemotePairing record over USB so clipboard sync works over local Wi-Fi without cables."
                                        FontSize="12"
                                        Foreground="#8A8A92"
                                        TextWrapping="Wrap" />
                                    <Button
                                        x:Name="PairWifiBtn"
                                        Click="OnPairWifiClick"
                                        Background="#232328"
                                        BorderBrush="#2E2E34"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Padding="12,5">
                                        <TextBlock
                                            x:Name="PairWifiBtnText"
                                            Text="Pair Wireless Over USB"
                                            FontSize="12"
                                            Foreground="#F2F2F5" />
                                    </Button>
                                </StackPanel>
                                <TextBlock
                                    x:Name="Step2StatusText"
                                    Grid.Column="2"
                                    Text="Paired"
                                    FontSize="12"
                                    Foreground="#28C840"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Step 3: Transport Mode & Clear -->
                        <Border
                            Background="#18181B"
                            BorderBrush="#242428"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16,14">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Text="03"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#6E6E76"
                                    Typography.NumeralAlignment="Tabular"
                                    VerticalAlignment="Top"
                                    Margin="0,2,0,0" />
                                <StackPanel Grid.Column="1" Spacing="8">
                                    <TextBlock
                                        Text="Transport Preference"
                                        FontSize="13.5"
                                        FontWeight="SemiBold"
                                        Foreground="#F2F2F5" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button
                                            x:Name="TransportAutoBtn"
                                            Content="Auto"
                                            Click="OnTransportAutoClick"
                                            FontSize="12"
                                            Padding="12,4"
                                            CornerRadius="6"
                                            Background="#2A2A30"
                                            BorderBrush="#3A3A42"
                                            BorderThickness="1"
                                            Foreground="#F2F2F5" />
                                        <Button
                                            x:Name="TransportWifiBtn"
                                            Content="Wi-Fi"
                                            Click="OnTransportWifiClick"
                                            FontSize="12"
                                            Padding="12,4"
                                            CornerRadius="6"
                                            Background="Transparent"
                                            BorderBrush="#2A2A30"
                                            BorderThickness="1"
                                            Foreground="#8A8A92" />
                                        <Button
                                            x:Name="TransportUsbBtn"
                                            Content="USB"
                                            Click="OnTransportUsbClick"
                                            FontSize="12"
                                            Padding="12,4"
                                            CornerRadius="6"
                                            Background="Transparent"
                                            BorderBrush="#2A2A30"
                                            BorderThickness="1"
                                            Foreground="#8A8A92" />
                                    </StackPanel>
                                </StackPanel>

                                <Button
                                    Click="OnClearHistoryClick"
                                    Grid.Column="2"
                                    Background="#232328"
                                    BorderBrush="#2E2E34"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Padding="10,5"
                                    VerticalAlignment="Center">
                                    <TextBlock Text="Clear History" FontSize="12" Foreground="#9A9AA2" />
                                </Button>
                            </Grid>
                        </Border>

                        <TextBlock
                            x:Name="OnboardingFeedbackText"
                            Text=""
                            FontSize="12"
                            Foreground="#8A8A92" />
                    </StackPanel>
                </ScrollViewer>

                <!-- LAYER C: ABOUT UNIVERSAL CLIPBOARD PANE (Monochrome Carbon-Graphite) -->
                <ScrollViewer
                    x:Name="AboutPane"
                    Visibility="Collapsed"
                    VerticalScrollBarVisibility="Auto"
                    Padding="36,28">
                    <StackPanel MaxWidth="520" HorizontalAlignment="Center" Spacing="16">
                        <!-- Header Row -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Width="44"
                                Height="44"
                                CornerRadius="11"
                                Background="#1C1C21"
                                BorderBrush="#2C2C34"
                                BorderThickness="1"
                                Margin="0,0,14,0"
                                VerticalAlignment="Center">
                                <FontIcon
                                    Glyph="&#xE81E;"
                                    FontSize="19"
                                    Foreground="#F2F2F5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock
                                        Text="Universal Clipboard"
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Foreground="#F2F2F5" />
                                    <Border
                                        Background="#222228"
                                        BorderBrush="#303038"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="7,1"
                                        VerticalAlignment="Center">
                                        <TextBlock
                                            Text="v1.2.0"
                                            FontSize="11"
                                            FontWeight="Medium"
                                            Foreground="#B8B8C2"
                                            Typography.NumeralAlignment="Tabular" />
                                    </Border>
                                </StackPanel>
                                <TextBlock
                                    Text="Native iPhone ⇄ Windows Continuity Clipboard Engine"
                                    FontSize="12.5"
                                    Foreground="#8A8A92" />
                            </StackPanel>

                            <Button
                                Grid.Column="2"
                                Click="OnRailClipboardClick"
                                Background="#212125"
                                BorderBrush="#2C2C30"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="12,5"
                                VerticalAlignment="Top">
                                <TextBlock Text="Close" FontSize="12" FontWeight="SemiBold" Foreground="#F2F2F5" />
                            </Button>
                        </Grid>

                        <!-- Card 1: Live Runtime Status -->
                        <Border
                            Background="#18181B"
                            BorderBrush="#242428"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16,14">
                            <StackPanel Spacing="10">
                                <TextBlock
                                    Text="RUNTIME STATUS"
                                    FontSize="10.5"
                                    FontWeight="SemiBold"
                                    Foreground="#66666E" />

                                <Grid RowSpacing="8" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Paired Device" FontSize="12.5" Foreground="#8A8A92" />
                                    <TextBlock x:Name="AboutDeviceText" Grid.Row="0" Grid.Column="1" Text="iPhone 16e (iPhone17,5) · iOS 27.0" FontSize="12.5" FontWeight="Medium" Foreground="#E4E4EA" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Active Transport" FontSize="12.5" Foreground="#8A8A92" />
                                    <TextBlock x:Name="AboutTransportText" Grid.Row="1" Grid.Column="1" Text="Wi-Fi (_remotepairing._tcp.local.)" FontSize="12.5" FontWeight="Medium" Foreground="#E4E4EA" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Local API Endpoint" FontSize="12.5" Foreground="#8A8A92" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="http://127.0.0.1:8767 (CoreDevice Daemon)" FontSize="12.5" Foreground="#B8B8C2" Typography.NumeralAlignment="Tabular" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Architecture & Protocol -->
                        <Border
                            Background="#18181B"
                            BorderBrush="#242428"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16,14">
                            <StackPanel Spacing="10">
                                <TextBlock
                                    Text="CORE ARCHITECTURE"
                                    FontSize="10.5"
                                    FontWeight="SemiBold"
                                    Foreground="#66666E" />

                                <Grid RowSpacing="8" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="RemoteXPC Service" FontSize="12.5" Foreground="#8A8A92" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="com.apple.coredevice.pasteboardservice" FontSize="12.5" Foreground="#D4D4DC" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Darwin Notification" FontSize="12.5" Foreground="#8A8A92" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="com.apple.pasteboard.notify.changed" FontSize="12.5" Foreground="#D4D4DC" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Inclusion Policy" FontSize="12.5" Foreground="#8A8A92" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="POLICY_PROMISE_SECONDARY + RESOLVE" FontSize="12.5" Foreground="#D4D4DC" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Windows Formats" FontSize="12.5" Foreground="#8A8A92" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="CF_UNICODETEXT · HTML · CF_DIBV5 · PNG · CF_HDROP" FontSize="12.5" Foreground="#D4D4DC" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Keyboard Shortcuts -->
                        <Border
                            Background="#18181B"
                            BorderBrush="#242428"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16,14">
                            <StackPanel Spacing="10">
                                <TextBlock
                                    Text="KEYBOARD SHORTCUTS"
                                    FontSize="10.5"
                                    FontWeight="SemiBold"
                                    Foreground="#66666E" />

                                <Grid RowSpacing="8" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Win + Alt + V" FontSize="12.5" FontWeight="SemiBold" Foreground="#E4E4EA" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Toggle floating Quick Paste manager anywhere" FontSize="12.5" Foreground="#8A8A92" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Ctrl + 1 .. 9" FontSize="12.5" FontWeight="SemiBold" Foreground="#E4E4EA" Typography.NumeralAlignment="Tabular" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Instant paste item #1–#9 in Quick Paste" FontSize="12.5" Foreground="#8A8A92" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="C / S" FontSize="12.5" FontWeight="SemiBold" Foreground="#E4E4EA" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Copy to Windows (C) or Send to iPhone (S)" FontSize="12.5" Foreground="#8A8A92" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="F / D" FontSize="12.5" FontWeight="SemiBold" Foreground="#E4E4EA" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="Toggle Favorite (F) or Delete selected clip (D)" FontSize="12.5" Foreground="#8A8A92" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
