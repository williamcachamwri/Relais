                        <Border
                            Background="#111111"
                            BorderBrush="#1A1A1A"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,14">
                            <StackPanel Spacing="10">
                                <TextBlock
                                    Text="CORE ARCHITECTURE"
                                    FontSize="10.5"
                                    FontWeight="SemiBold"
                                    Foreground="#676767" />

                                <Grid RowSpacing="8" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="RemoteXPC Service" FontSize="12.5" Foreground="#8B8B8B" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="com.apple.coredevice.pasteboardservice" FontSize="12.5" Foreground="#D5D5D5" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Darwin Notification" FontSize="12.5" Foreground="#8B8B8B" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="com.apple.pasteboard.notify.changed" FontSize="12.5" Foreground="#D5D5D5" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Inclusion Policy" FontSize="12.5" Foreground="#8B8B8B" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="POLICY_PROMISE_SECONDARY + RESOLVE" FontSize="12.5" Foreground="#D5D5D5" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Windows Formats" FontSize="12.5" Foreground="#8B8B8B" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="CF_UNICODETEXT · HTML · CF_DIBV5 · PNG · CF_HDROP" FontSize="12.5" Foreground="#D5D5D5" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Keyboard Shortcuts -->
                        <Border
                            Background="#111111"
                            BorderBrush="#1A1A1A"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,14">
                            <StackPanel Spacing="10">
                                <TextBlock
                                    Text="KEYBOARD SHORTCUTS"
                                    FontSize="10.5"
                                    FontWeight="SemiBold"
                                    Foreground="#676767" />

                                <Grid RowSpacing="8" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Win + Alt + V" FontSize="12.5" FontWeight="SemiBold" Foreground="#E5E5E5" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Toggle floating Quick Paste manager anywhere" FontSize="12.5" Foreground="#8B8B8B" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Ctrl + 1 .. 9" FontSize="12.5" FontWeight="SemiBold" Foreground="#E5E5E5" Typography.NumeralAlignment="Tabular" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Instant paste item #1–#9 in Quick Paste" FontSize="12.5" Foreground="#8B8B8B" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="C / S" FontSize="12.5" FontWeight="SemiBold" Foreground="#E5E5E5" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Copy to Windows (C) or Send to iPhone (S)" FontSize="12.5" Foreground="#8B8B8B" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="F / D" FontSize="12.5" FontWeight="SemiBold" Foreground="#E5E5E5" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="Toggle Favorite (F) or Delete selected clip (D)" FontSize="12.5" Foreground="#8B8B8B" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- LAYER D: BACKEND LOGS PANE (Terminal / Developer Console) -->
                <Grid
                    x:Name="LogsPane"
                    Visibility="Collapsed"
                    Background="#0C0C0C"
                    RowSpacing="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Logs Pane Header -->
                    <Border
                        Grid.Row="0"
                        Background="#0F0F0F"
                        BorderBrush="#1A1A1A"
                        BorderThickness="0,0,0,1"
                        Padding="20,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE756;" FontSize="15" Foreground="#A1A1A1" />
                                <TextBlock
                                    Text="CoreDevice Backend Logs"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="#EEEEEE" />
                                <Border
                                    Background="#1A1A1A"
                                    BorderBrush="#2C2C2C"
                                    BorderThickness="1"
                                    CornerRadius="4.0"
                                    Padding="6,2">
                                    <TextBlock
                                        x:Name="LogsStatusBadge"
                                        Text="LIVE · 127.0.0.1:8767"
                                        FontSize="10.5"
                                        Foreground="#A7A7A7"
                                        FontWeight="Medium" />
                                </Border>
                            </StackPanel>

                            <!-- Header Actions -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button
                                    Click="OnRefreshLogsClick"
                                    Background="#181818"
                                    BorderBrush="#202020"
                                    BorderThickness="1"
                                    CornerRadius="6.0"
                                    Padding="10,4"
                                    ToolTipService.ToolTip="Refresh Logs (F5)">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE72C;" FontSize="11" Foreground="#A1A1A1" />
                                        <TextBlock Text="Refresh" FontSize="11.5" Foreground="#EEEEEE" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Click="OnCopyLogsClick"
                                    Background="#181818"
                                    BorderBrush="#202020"
                                    BorderThickness="1"
                                    CornerRadius="6.0"
                                    Padding="10,4"
                                    ToolTipService.ToolTip="Copy all logs to Windows Clipboard">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="11" Foreground="#A1A1A1" />
                                        <TextBlock Text="Copy" FontSize="11.5" Foreground="#EEEEEE" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Click="OnClearLogsClick"
                                    Background="#181818"
                                    BorderBrush="#202020"
                                    BorderThickness="1"
                                    CornerRadius="6.0"
                                    Padding="10,4"
                                    ToolTipService.ToolTip="Clear Backend Buffer">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="#A1A1A1" />
                                        <TextBlock Text="Clear" FontSize="11.5" Foreground="#EEEEEE" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Click="OnRailClipboardClick"
                                    Background="#181818"
                                    BorderBrush="#202020"
                                    BorderThickness="1"
                                    CornerRadius="6.0"
                                    Padding="10,4">
                                    <TextBlock Text="Close" FontSize="11.5" Foreground="#EEEEEE" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Terminal Content Body (Framed elevated terminal console) -->
                    <Border
                        Grid.Row="1"
                        Background="#080808"
                        BorderBrush="#171717"
                        BorderThickness="1"
                        CornerRadius="6"
                        Margin="16,12">
                        <ScrollViewer
                            x:Name="LogsScrollViewer"
                            Background="Transparent"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto"
                            Padding="0">
                            <TextBox
                                x:Name="LogsContentTextBox"
                                IsReadOnly="True"
                                AcceptsReturn="True"
                                TextWrapping="NoWrap"
                                FontFamily="Cascadia Code, Consolas, Courier New"
                                FontSize="12"
                                Foreground="#D5D5D5"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="16,12" />
                        </ScrollViewer>
                    </Border>

                    <!-- Status Footer -->
                    <Border
                        Grid.Row="2"
                        Background="#0E0E0E"
                        BorderBrush="#171717"
                        BorderThickness="0,1,0,0"
                        Padding="16,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="LogsFooterInfo"
                                Text="Showing latest 300 lines · Auto-scroll active"
                                FontSize="11"
                                Foreground="#6F6F6F" />
                            <CheckBox
                                x:Name="LogsAutoScrollCheck"
                                Grid.Column="1"
                                Content="Auto-scroll"
                                IsChecked="True"
                                FontSize="11"
                                Foreground="#8F8F8F"
                                MinWidth="0"
                                Padding="6,0,0,0" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
