<Window
    x:Class="UniversalClipboard.QuickPasteWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Relais">

    <Grid
        x:Name="PopupRoot"
        RequestedTheme="Dark"
        Background="#141417"
        KeyDown="OnRootKeyDown">
        <Grid.Resources>
            <Style x:Key="QuickTabStyle" TargetType="Button">
                <Setter Property="Height" Value="26" />
                <Setter Property="Padding" Value="11,0,11,0" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="Background" Value="#1D1D22" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="#8E8E98" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Medium" />
            </Style>
            <Style x:Key="KeycapStyle" TargetType="Border">
                <Setter Property="MinWidth" Value="18" />
                <Setter Property="Height" Value="18" />
                <Setter Property="Padding" Value="4,0,4,0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Background" Value="#1C1C21" />
                <Setter Property="BorderBrush" Value="#2C2C33" />
                <Setter Property="BorderThickness" Value="1,1,1,2" />
            </Style>
            <Style x:Key="KeycapTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="Foreground" Value="#9A9AA3" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Search Pill Bar -->
        <Border
            Grid.Row="0"
            Margin="12,12,12,8"
            Height="34"
            Background="#1C1C21"
            BorderBrush="#2A2A32"
            BorderThickness="1"
            CornerRadius="8"
            Padding="11,0">
            <Grid ColumnSpacing="8" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <FontIcon
                    Grid.Column="0"
                    Glyph="&#xE721;"
                    FontSize="12.5"
                    Foreground="#787882"
                    VerticalAlignment="Center" />

                <TextBox
                    x:Name="QuickSearchBox"
                    Grid.Column="1"
                    PlaceholderText="Search clipboard..."
                    TextChanged="OnQuickSearchTextChanged"
                    PreviewKeyDown="OnSearchBoxPreviewKeyDown"
                    Background="Transparent"
                    BorderThickness="0"
                    MinHeight="0"
                    Height="26"
                    Padding="0,3,0,3"
                    FontSize="13"
                    Foreground="#F2F2F5"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center">
                    <TextBox.Resources>
                        <x:Double x:Key="TextControlThemeMinHeight">24</x:Double>
                        <x:Double x:Key="TextControlThemeMinWidth">0</x:Double>
                        <Thickness x:Key="TextControlThemePadding">0,3,0,3</Thickness>
                        <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#F2F2F5" />
                        <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#6E6E77" />
                        <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#82828C" />
                        <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#5E5E66" />
                    </TextBox.Resources>
                </TextBox>

                <TextBlock
                    x:Name="QuickItemCountText"
                    Grid.Column="2"
                    Text="0 items"
                    FontSize="11.5"
                    Foreground="#66666F"
                    Typography.NumeralAlignment="Tabular"
                    VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Row 1: Filter Pill Tabs -->
        <Grid
            Grid.Row="1"
            BorderBrush="#202026"
            BorderThickness="0,0,0,1"
            Padding="12,0,12,9">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button x:Name="TabAllBtn" Tag="all" Click="OnTabFilterClick" Style="{StaticResource QuickTabStyle}">
                    <TextBlock Text="All" />
                </Button>
                <Button x:Name="TabTextBtn" Tag="text" Click="OnTabFilterClick" Style="{StaticResource QuickTabStyle}">
                    <TextBlock Text="Text" />
                </Button>
                <Button x:Name="TabRichTextBtn" Tag="richtext" Click="OnTabFilterClick" Style="{StaticResource QuickTabStyle}">
                    <TextBlock Text="Rich Text" />
                </Button>
                <Button x:Name="TabImageBtn" Tag="image" Click="OnTabFilterClick" Style="{StaticResource QuickTabStyle}">
                    <TextBlock Text="Image" />
                </Button>
                <Button x:Name="TabFileBtn" Tag="file" Click="OnTabFilterClick" Style="{StaticResource QuickTabStyle}" Visibility="Collapsed">
                    <TextBlock Text="File" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Row 2: Clip List -->
        <Grid Grid.Row="2">
            <ScrollViewer
                x:Name="QuickListScrollViewer"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Enabled"
                HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="QuickItemsPanel" Spacing="2" Padding="8,6,8,6" />
            </ScrollViewer>

            <StackPanel
                x:Name="QuickEmptyState"
                Visibility="Collapsed"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Spacing="4">
                <TextBlock
                    Text="Nothing here yet"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="#8A8A92"
                    HorizontalAlignment="Center" />
                <TextBlock
                    Text="Copy on iPhone or Windows and it shows up here."
                    FontSize="12"
                    Foreground="#5A5A62"
                    HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Row 3: Footer -->
        <Grid
            Grid.Row="3"
            Height="34"
            Padding="14,0,14,0"
            Background="#101013"
            BorderBrush="#222228"
            BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                Orientation="Horizontal"
                Spacing="6"
                VerticalAlignment="Center">
                <FontIcon
                    x:Name="FooterSourceIcon"
                    Glyph="&#xE8EA;"
                    FontSize="11"
                    Foreground="#6C6C75" />
                <TextBlock
                    x:Name="FooterSourceText"
                    Text="Relais"
                    FontSize="11.5"
                    Foreground="#6C6C75"
                    TextTrimming="CharacterEllipsis"
                    Typography.NumeralAlignment="Tabular" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="10"
                VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <Border Style="{StaticResource KeycapStyle}"><TextBlock Text="↵" Style="{StaticResource KeycapTextStyle}" /></Border>
                    <TextBlock Text="Paste" FontSize="11.5" Foreground="#6C6C75" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <Border Style="{StaticResource KeycapStyle}"><TextBlock Text="↑↓" Style="{StaticResource KeycapTextStyle}" /></Border>
                    <TextBlock Text="Move" FontSize="11.5" Foreground="#6C6C75" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <Border Style="{StaticResource KeycapStyle}"><TextBlock Text="esc" Style="{StaticResource KeycapTextStyle}" /></Border>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
