<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <!-- MSI version can be overridden at build time: wix build -d Version=x.y.z -->
  <?ifndef Version ?>
  <?define Version = "2.1.0" ?>
  <?endif?>

  <Package Name="Relais"
           Manufacturer="Relais"
           Version="$(Version)"
           UpgradeCode="48D93E42-6A81-4C0F-873E-F8B429A265B1"
           Scope="perUserOrMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Relais is already installed." />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- "Launch Relais after install" checkbox shown on the Finish dialog -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Relais after installation" />
    <!-- Default the checkbox to checked (1 = checked) -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[INSTALLFOLDER]Relais.exe" />
    <CustomAction Id="LaunchApplication"
                  BinaryRef="Wix4UtilCA_X64"
                  DllEntry="WixShellExec"
                  Impersonate="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Relais" />
    </StandardDirectory>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="d:\UniversalClipboard\dist\Relais\**" />
    </ComponentGroup>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="ApplicationShortcut" Guid="B63E48C2-4B60-4E87-8A33-72C9E44F35E2">
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Name="Relais"
                  Description="Universal Clipboard for Windows and iPhone"
                  Target="[INSTALLFOLDER]Relais.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RegistryValue Root="HKCU"
                       Key="Software\Relais"
                       Name="installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Icon Id="AppIcon" SourceFile="Assets\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <UI>
      <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
      <!-- Fire LaunchApplication only when the checkbox is ticked and this is a fresh install -->
      <Publish Dialog="ExitDialog"
               Control="Finish"
               Event="DoAction"
               Value="LaunchApplication"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>

    <Feature Id="Main" Title="Relais">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>

  </Package>
</Wix>
